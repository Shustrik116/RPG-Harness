    private static string PlanSummary(System.Text.Json.Nodes.JsonObject a) =>
        a["enemies"] is System.Text.Json.Nodes.JsonArray arr
            ? string.Join(", ", arr.OfType<System.Text.Json.Nodes.JsonObject>().Select(o =>
                (o["count"]?.ToString() is { } cnt && cnt != "1" ? $"{cnt} × " : "") + (o["name"]?.ToString() ?? "?")))
            : "";

    /// <summary>Человекочитаемая подпись вызова инструмента: иконка + что изменилось.</summary>
    private static (string Icon, string Text) ToolLabel(ToolCall call)
    {
        var a = Args(call);
        var name = S(a, "name") ?? "";
        switch (call.Name)
        {
            case "create_file": return ("📜", $"{Lang.T("файл", "file")} {S(a, "path")}");
            case "edit_file": return ("✏️", $"{(S(a, "append") is not null ? Lang.T("дополнен", "appended") : Lang.T("правка", "edit"))} {S(a, "path")}");
            case "read_file": return ("📖", $"{Lang.T("чтение", "reading")} {S(a, "path")}");
            case "list_files": return ("🗂", Lang.T("список файлов", "file list"));
            case "start_instance": return ("🌀", $"{Lang.T("начало", "start")}: {S(a, "title")}");
            case "initiative":
                if (a["clear"]?.ToString() == "true") return ("🚩", Lang.T("очередь хода сброшена", "turn order reset"));
                if (a["remove"]?.ToString() == "true") return ("🚩", $"{Lang.T("из очереди", "removed from the queue")}: {name}");
                return S(a, "value") is { Length: > 0 } value
                    ? ("🚩", $"{Lang.T("инициатива", "initiative")} {name}: {value}")
                    : ("🚩", Lang.T("очередь хода", "turn order"));
            case "combat_turn": return ("⏱", S(a, "action") == "advance" ? $"{Lang.T("ход завершён", "turn done")}: {S(a, "actor")}" : Lang.T("порядок раунда", "round order"));
            case "resolve_attack":
                return (S(a, "mode") switch { "heal" => "✚", "shield" => "🛡", "buff" => "✦", _ => "⚔️" },
                    $"{S(a, "attacker")}{(S(a, "skill") is { Length: > 0 } sk ? $" · {sk}" : "")} → {S(a, "target")}");
            case "skill_check":
                return ("🎲", $"{(a["save"]?.ToString() == "true" ? Lang.T("спасбросок", "saving throw") : Lang.T("проверка", "check"))}: {S(a, "skill")} (DC {S(a, "dc")})" +
                              (call.Ok == true && call.Result is { } cr && System.Text.RegularExpressions.Regex.Match(cr, @"— (БЛЕСТЯЩИЙ УСПЕХ|УСПЕХ ЦЕНОЙ|УСПЕХ|ПРОВАЛ С ОСЛОЖНЕНИЕМ|ПРОВАЛ|BRILLIANT SUCCESS|SUCCESS AT A COST|SUCCESS|FAILURE WITH A COMPLICATION|FAILURE)") is { Success: true } cm
                                  ? $" — {cm.Groups[1].Value.ToLowerInvariant()}" : ""));
            case "rest": return ("🏕", S(a, "kind") == "long" ? Lang.T("ночлег", "night's rest") : Lang.T("короткий привал", "short halt"));
            case "update_clock" when call.Result?.Contains(", тайные") == true || call.Result?.Contains(", secret") == true:
                return ("⏳", Lang.T("мир не стоит на месте…", "the world does not stand still…"));
            case "update_clock":
                return ("⏳", $"{name}{(S(a, "tick") is { Length: > 0 } tk && tk != "0" ? $" {(tk.StartsWith('-') ? tk : "+" + tk)}" : "")}" +
                              (a["remove"]?.ToString() == "true" ? Lang.T(" — снято", " — removed") : a["reset"]?.ToString() == "true" ? Lang.T(" — сброс", " — reset") : ""));
            case "update_faction":
                return ("🏳", $"{name}{(S(a, "delta") is { Length: > 0 } fd ? $" {(fd.StartsWith('-') ? fd : "+" + fd)}" : "")}");
            case "resolve_death_save": return ("☠", $"{Lang.T("спасбросок", "death save")}: {S(a, "target")}");
            case "finish_instance": return ("↩️", Lang.T("итоги изолированной сцены", "isolated scene outcome"));
            case "set_stat": return ("💪", $"{S(a, "stat")?.ToUpperInvariant()} → {S(a, "value")}");
            case "update_npc": return ("👤", name);
            case "update_party_member": return ("🧭", $"{Lang.T("спутник", "companion")}: {name}");
            case "recruit_companion": return ("🤝", $"{Lang.T("в группе", "joined")}: {name}{(S(a, "class") is { Length: > 0 } rc ? $", {rc}" : "")}");
            case "update_companion_candidate": return ("🧭", $"{Lang.T("кандидат", "candidate")}: {name}{(S(a, "action") is { Length: > 0 } ca ? $" · {ca}" : "")}");
            case "plan_encounter": return ("⚖️", $"{Lang.T("расчёт боя", "combat planning")}: {PlanSummary(a)}");
            case "award_xp": return ("⭐", call.Ok == true && call.Result is { } xr && System.Text.RegularExpressions.Regex.Match(xr, @"(?:опыт|XP) \d+ → \d+") is { Success: true } xm ? xm.Value : Lang.T("опыт", "XP"));
            case "level_up": return ("⬆️", $"{Lang.T("новый уровень", "new level")}: {(S(a, "owner") is { } lo && lo != "hero" ? lo : Lang.T("герой", "hero"))}");
            case "roll_loot": return ("💰", S(a, "source") == "chest" ? Lang.T("добыча из тайника", "loot from a cache") : Lang.T("добыча с поверженных", "loot from the defeated"));
            case "update_party_inventory": return ("🎒", $"{S(a, "member")}: {S(a, "item")}");
            case "recall_rumor": return ("💭", $"{Lang.T("вспомнить", "recall")}: {S(a, "linked_to")}");
            case "update_adversary": return ("⚔️", a["remove"]?.ToString() == "true" ? $"{name} — {Lang.T("выбыл", "out")}" : $"{name} {HpText(a)}".Trim());
            case "update_city": return ("🏰", string.IsNullOrWhiteSpace(S(a, "poi_name")) ? name : $"{name}: {S(a, "poi_name")}");
            case "update_quest": return ("📌", $"{name}{StateText(S(a, "state"))}");
            case "update_arc": return ("🎯", $"{name}{StateText(S(a, "state"))}");
            case "update_world_event": return ("🌍", name);
            case "set_world_state": return ("🕰", Lang.T("состояние мира", "world state"));
            case "set_merchant": return ("🏪", $"{Lang.T("лавка", "shop")}: {S(a, "npc")}{(a["restock"]?.ToString() == "true" ? Lang.T(" (завоз)", " (restock)") : "")}");
            case "update_shop_item":
                return ("🏷", $"{S(a, "npc")}: {(a["remove"]?.ToString() == "true" || S(a, "quantity") == "0" ? "−" : "")}{name}{(S(a, "price") is { } pr ? $" {pr} {Genre.Coin}" : "")}");
            case "equip_item":
                return ("🛡", a["unequip"]?.ToString() == "true" ? $"{Lang.T("снято", "taken off")}: {S(a, "slot")}" : $"{Lang.T("надето", "equipped")}: {name}");
            case "update_grid_item":
            case "update_inventory":
                return ("🎒", a["remove"]?.ToString() == "true" ? $"−{name}" : $"{name}{(S(a, "quantity") is { } q ? $" x{q}" : "")}");
            case "street_offer": return ("🧾", S(a, "seller") is { Length: > 0 } sl ? $"{Lang.T("предложение от", "an offer from")}: {sl}" : Lang.T("уличное предложение", "street offer"));
            case "street_deal": return ("🧾", S(a, "action") == "reject" ? Lang.T("сделка отклонена", "deal declined") : Lang.T("уличная сделка", "street deal"));
            case "update_character":
                var parts = new List<string>();
                if (S(a, "hp_current") is { } hp) parts.Add($"{Lang.T("ХП", "HP")} {hp}");
                if (S(a, "hp_max") is { } hpm) parts.Add($"{Lang.T("макс. ХП", "max HP")} {hpm}");
                if (S(a, "mana_current") is { } mp) parts.Add($"{Genre.Mana} {mp}");
                if (S(a, "gold") is { } g) parts.Add($"{Genre.Money} {g}");
                if (S(a, "xp") is { } xp) parts.Add($"{Lang.T("опыт", "XP")} {xp}");
                if (S(a, "level") is { } lv) parts.Add($"{Lang.T("уровень", "level")} {lv}");
                if (S(a, "add_status") is { } st) parts.Add($"+{st}");
                if (S(a, "remove_status") is { } rs) parts.Add($"−{rs}");
                return ("🧙", parts.Count > 0 ? string.Join(", ", parts) : Lang.T("лист героя", "hero sheet"));
            default: return ("🛠", call.Name);
        }

        static string HpText(System.Text.Json.Nodes.JsonObject o) =>
            S(o, "hp_current") is { } cur ? $"{Lang.T("ХП", "HP")} {cur}{(S(o, "hp_max") is { } max ? "/" + max : "")}" : "";

        static string StateText(string? state) => state switch
        {
            "done" => " ✓",
            "failed" => " ✗",
            "abandoned" => Lang.T(" (оставлена)", " (abandoned)"),
            "active" => Lang.T(" (активна)", " (active)"),
            _ => "",
        };
    }

    private static (string? Question, List<string> Options) ParseChoices(ToolCall call)
    {
        var a = Args(call);
        var options = (a["options"] as System.Text.Json.Nodes.JsonArray)?
            .Select(FileTools.ChoiceText)
            .Where(o => !string.IsNullOrEmpty(o))
            .Select(o => o!)
            .Take(8)
            .ToList() ?? new();
        return (S(a, "question"), options);
    }

    private sealed record ArcOption(string Name, string Premise)
    {
        public string PickMessage => Lang.T($"Выбираю арку «{Name}».", $"I choose the arc \"{Name}\".");
    }

    private static List<ArcOption> ParseArcs(ToolCall call)
    {
        var a = Args(call);
        return (a["arcs"] as System.Text.Json.Nodes.JsonArray)?
            .OfType<System.Text.Json.Nodes.JsonObject>()
            .Select(o => new ArcOption(S(o, "name") ?? "", S(o, "premise") ?? ""))
            .Where(o => o.Name.Length > 0)
            .Take(6)
            .ToList() ?? new();
    }

    private static string TruncateResult(string result) =>
        result.Length <= 400 ? result : result[..400] + Lang.T("\n…(показано 400 символов)", "\n…(showing 400 characters)");

    public void Dispose()
    {
        if (_tradeSubscribed)
        {
            Trade.Completed -= OnTradeCompleted;
            Guild.Completed -= OnGuildCompleted;
            Battle.ActionRequested -= OnBattleAction;
            RpgStore.StateChanged -= OnRpgStateChanged;
            PartyFlow.LeaveRequested -= OnPartyLeaveRequested;
            PartyFlow.ItemActionRequested -= OnPartyItemActionRequested;
            Talk.TalkRequested -= OnTalkRequested;
        }

        _cts?.Cancel();
        _cts?.Dispose();
        _self?.Dispose();

        if (_watched)
        {
            try
            {
                _ = JS.InvokeVoidAsync("harness.unwatchEnter", _inputRef).AsTask()
                    .ContinueWith(_ => { }, TaskScheduler.Default);
            }
            catch
            {
                // ignorable
            }
        }
    }
}
