@code {
    /// <summary>Лимит раундов «генерация → инструменты» за один ход (создание мира требует многих вызовов).</summary>
    private const int MaxToolRounds = 24;

    private static readonly Markdig.MarkdownPipeline MdPipeline = new Markdig.MarkdownPipelineBuilder()
        .UseEmphasisExtras()
        .UsePipeTables()
        .UseSoftlineBreakAsHardlineBreak()
        .DisableHtml()
        .Build();

    [Parameter] public string? Id { get; set; }

    private ChatSession? _session;
    private string _draft = "";
    private string? _error;
    private string? _note;
    private bool _busy;
    private bool _executingTool;
    private CancellationTokenSource? _cts;
    private string _ownArc = "";
    private FileTools.CampaignPhase _phase;
    private StreamProgress? _progress;

    /// <summary>
    /// Плашка «Открыть окно битвы»: видна, пока бой идёт, пока победа не оформлена кнопкой
    /// «Забрать выбранное и завершить бой» (игрок должен успеть вернуться в окно и забрать добычу)
    /// и пока в окне добычи остались предметы.
    /// </summary>
    private bool BattleActive
    {
        get
        {
            if (_session is null) return false;
            var st = RpgStore.GetOrCreate(_session.Id);
            var alive = st.Adversaries.Any(a => !string.IsNullOrWhiteSpace(a.Name) && (a.HpMax <= 0 || a.InFight));
            var victory = st.Adversaries.Count > 0 && st.Adversaries.All(a => !a.InFight);
            return alive || victory || st.BattleLoot.Count > 0;
        }
    }

    private void OpenBattle()
    {
        if (_session is not null)
        {
            Battle.Open(_session.Id);
        }
    }

    /// <summary>Режим поля ввода: hero — персонаж в игре, player — игрок вне игры.</summary>
    private string _mode = "hero";
    private bool _asPlayer => _mode == "player";

    /// <summary>Вид текущего запроса (RequestKinds) — определяет температуру и рассуждения.</summary>
    private string? _kind;
    private bool _tradeSubscribed;

    private ElementReference _logRef;
    private ElementReference _inputRef;
    private ElementReference _fileInputRef;
    private DotNetObjectReference<Chat>? _self;
    private bool _watched;

    private readonly List<string> _pendingImages = new();

    private bool _panelOpen => RpgStore.PanelOpen;

    /// <summary>Модель мультимодальная — доступно прикрепление изображений.</summary>
    private bool VisionAvailable => SettingsSvc.Current.VisionEnabled;

    private void TogglePanel() => RpgStore.TogglePanel();

    private string HeroName
    {
        get
        {
            var name = RpgStore.GetOrCreate(_session?.Id).Character.Name;
            return string.IsNullOrWhiteSpace(name) ? Lang.T("Вы", "You") : name.Trim();
        }
    }

    private static string[] PhaseTitles => Lang.IsEn
        ? new[] { "Session zero", "Choosing an arc", "Adventure" }
        : new[] { "Сессия ноль", "Выбор арки", "Приключение" };

    private int PhaseIndex => _phase switch
    {
        FileTools.CampaignPhase.SessionZero => 0,
        FileTools.CampaignPhase.ArcChoice => 1,
        _ => 2,
    };

    /// <summary>Как показать реплику игрока: обычный текст, бросок кубика или итог сделки.</summary>
    private readonly record struct UserMsgView(string Kind, string? Label = null, string? Value = null, string? Text = null);

    private static UserMsgView UserView(string content)
    {
        var text = content ?? "";
        if (text.StartsWith("🎲 ", StringComparison.Ordinal))
        {
            var nl = text.IndexOf('\n');
            var head = nl < 0 ? text[3..] : text[3..nl];
            var colon = head.LastIndexOf(':');
            if (colon > 0)
            {
                return new UserMsgView("roll", head[..colon].Trim(), head[(colon + 1)..].Trim(),
                    nl < 0 ? null : text[(nl + 1)..]);
            }
        }

        if (IsTradeReceipt(text))
        {
            var nl = text.IndexOf('\n');
            var first = nl < 0 ? text : text[..nl];
            var prefix = first.StartsWith("🛒 Сделка", StringComparison.Ordinal) ? "🛒 Сделка".Length : "🛒 Deal".Length;
            var head = first[prefix..].Trim(' ', ':', '—', '-', '.');
            return new UserMsgView("receipt", Text: head.Length > 0 ? head : Lang.T("итог торговли", "trade outcome"));
        }

        return new UserMsgView("text");
    }

    /// <summary>Итог сделки из окна лавки — на любом языке интерфейса (сообщение пишет TradeWindow).</summary>
    private static bool IsTradeReceipt(string? text) =>
        (text ?? "").StartsWith("🛒 Сделка", StringComparison.Ordinal) || (text ?? "").StartsWith("🛒 Deal", StringComparison.Ordinal);

    /// <summary>Результат roll_dice без служебного эмодзи в начале.</summary>
    private static string CleanRoll(string? result) =>
        (result ?? "").Replace("🎲", "").Replace("️", "").Trim();

    /// <summary>Часть формулы броска: кубик («1d20», выпало «6») или плоская поправка (Die = null).</summary>
    private sealed record RollPart(string Sign, string? Die, string Value, string Note);

    private sealed record RollView(string Reason, List<RollPart> Parts, string Total);

    /// <summary>«d20+0 (причина): 1d20[6] + 0 = 6» — причина может содержать двоеточия и скобки, формула — нет.</summary>
    private static readonly System.Text.RegularExpressions.Regex RollLineRe = new(
        @"^(?<expr>[^(:]*?)(?:\s*\((?<why>.*)\))?:\s*(?<parts>.+?)\s*=\s*(?<total>-?\d+)\s*$",
        System.Text.RegularExpressions.RegexOptions.Compiled | System.Text.RegularExpressions.RegexOptions.Singleline);

    private static readonly System.Text.RegularExpressions.Regex RollTermRe = new(
        @"(?<sign>[+−-])?\s*(?:(?<die>\d*d(?:\d+|%))\[(?<inner>[^\]]*)\]|(?<flat>\d+))",
        System.Text.RegularExpressions.RegexOptions.Compiled | System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    /// <summary>
    /// Разбор результата roll_dice для плашки в чате: «1d20[Результат 6] + Бонус 0 = 6».
    /// Не разобралось — null, тогда плашка показывает строку как есть.
    /// </summary>
    private static RollView? ParseRoll(string? result)
    {
        var m = RollLineRe.Match(CleanRoll(result));
        if (!m.Success)
        {
            return null;
        }

        var parts = new List<RollPart>();
        foreach (System.Text.RegularExpressions.Match t in RollTermRe.Matches(m.Groups["parts"].Value))
        {
            var sign = t.Groups["sign"].Value is "-" or "−" ? "−" : t.Groups["sign"].Value == "+" ? "+" : "";
            if (t.Groups["flat"].Success)
            {
                parts.Add(new RollPart(sign, null, t.Groups["flat"].Value, ""));
                continue;
            }

            var inner = t.Groups["inner"].Value.Trim();
            string value, note = "";
            var keep = inner.IndexOf('⇒');
            var slash = inner.IndexOf('/');
            var arrow = inner.IndexOf('→');
            if (keep >= 0)
            {
                // 4d6kh3[6, 3, 5, 2 ⇒ 6+5+3] — оставлены лучшие кубики.
                value = inner[(keep + 1)..].Trim().Replace("+", " + ");
                note = Lang.T("брошено ", "rolled ") + inner[..keep].Trim();
            }
            else if (slash >= 0 && arrow > slash)
            {
                // 1d20[7/16→16] — преимущество или помеха.
                value = inner[(arrow + 1)..].Trim();
                note = Lang.T($"из {inner[..slash].Trim()} и {inner[(slash + 1)..arrow].Trim()}", $"of {inner[..slash].Trim()} and {inner[(slash + 1)..arrow].Trim()}");
            }
            else
            {
                value = string.Join(" + ", inner.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries));
            }

            parts.Add(new RollPart(sign, t.Groups["die"].Value, value, note));
        }

        return parts.Count == 0 ? null : new RollView(m.Groups["why"].Value.Trim(), parts, m.Groups["total"].Value);
    }

    private static string Roman(int n) => n switch
    {
        1 => "I", 2 => "II", 3 => "III", 4 => "IV", 5 => "V", 6 => "VI", 7 => "VII", 8 => "VIII", _ => n.ToString(),
    };

    private string? _welcomeHint
    {
        get
        {
            var settings = SettingsSvc.Current;
            if (string.IsNullOrWhiteSpace(settings.ApiBaseUrl))
            {
                return Lang.T("Не задан адрес API —", "The API address is not set —");
            }

            if (settings.ApiBaseUrl.Contains("api.openai.com", StringComparison.OrdinalIgnoreCase)
                && string.IsNullOrWhiteSpace(settings.ApiKey))
            {
                return Lang.T("Не задан API-ключ —", "The API key is not set —");
            }

            if (string.IsNullOrWhiteSpace(settings.WorkDirectory))
            {
                return Lang.T("Рабочая директория не выбрана: кампания не сохранится, а мастер не сможет вести файлы —", "No working directory is chosen: the campaign will not be saved and the master will not be able to keep files —");
            }

            return null;
        }
    }

    protected override void OnInitialized()
    {
        Trade.Completed += OnTradeCompleted;
        Guild.Completed += OnGuildCompleted;
        Battle.ActionRequested += OnBattleAction;
        RpgStore.StateChanged += OnRpgStateChanged;
        PartyFlow.LeaveRequested += OnPartyLeaveRequested;
        PartyFlow.ItemActionRequested += OnPartyItemActionRequested;
        Talk.TalkRequested += OnTalkRequested;
        _tradeSubscribed = true;
    }

    private void OnGuildCompleted(string chatId, string summary)
    {
        if (_session?.Id != chatId || string.IsNullOrWhiteSpace(summary)) return;
        _ = InvokeAsync(async () => await SendTextAsync(summary, clearDraft: false, ooc: false, kind: RequestKinds.Story));
    }
    private void OnBattleAction(string chatId, string summary)
    {
        if (_session?.Id != chatId || string.IsNullOrWhiteSpace(summary)) return;
        BattleLogSvc.Add(chatId, "turn", "▸", BattleLogFeed.TurnLine(summary));
        _ = InvokeAsync(async () => await SendTextAsync(summary, clearDraft: false, ooc: false, kind: RequestKinds.Combat));
    }

    /// <summary>Мастер обновил книгу героя — перерисовываем плавающую кнопку боя.</summary>
    private void OnRpgStateChanged(string sessionId)
    {
        if (_session?.Id == sessionId)
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }
    private void OnPartyLeaveRequested(string chatId, string member, string reason)
    {
        if (_session?.Id != chatId) return;
        var message = Lang.T($"[РАЗГОВОР СО СПУТНИКОМ] Я прошу {member} покинуть группу. Моя причина: {reason}. Отыграй личный разговор и реакцию спутника. Не удаляй его автоматически до исхода разговора; если расстаёмся нормально — update_party_member remove=true, departure=normal.",
            $"[TALK WITH A COMPANION] I ask {member} to leave the party. My reason: {reason}. Play out a personal conversation and the companion's reaction. Do not remove them automatically before the outcome of the conversation; if we part on good terms — update_party_member remove=true, departure=normal.");
        _ = InvokeAsync(async () => await SendTextAsync(message, clearDraft: false, ooc: false, kind: RequestKinds.Story));
    }

    /// <summary>Кнопка «Начать разговор» в панели: встреча целиком достаётся мастеру — он сам решит, чем она будет.</summary>
    private void OnTalkRequested(string chatId, string npc)
    {
        if (_session?.Id != chatId || string.IsNullOrWhiteSpace(npc)) return;
        var message = Lang.T($"[ВСТРЕЧА] Я зову к разговору: «{npc}». Возьми инициативу в свои руки и предложи то, с чего начнётся эта встреча: покупку слухов (buy_rumors), небольшой квест или завязку активной арки (update_quest), либо разовую уличную сделку через street_offer — вещь и цену подберёт харнес, продавец остаётся разовым событием и в списки персонажей не идёт (без update_npc). Закрой реплику через offer_choices (2–4 варианта).",
            $"[ENCOUNTER] I call \"{npc}\" over to talk. Take the initiative and offer how this encounter begins: buying rumors (buy_rumors), a small quest or a hook of the active arc (update_quest), or a one-off street deal via street_offer — the harness picks the item and the price, the seller remains a one-off event and does not go into the character lists (no update_npc). Close the line with offer_choices (2–4 options).");
        _ = InvokeAsync(async () => await SendTextAsync(message, clearDraft: false, ooc: false, kind: RequestKinds.Story));
    }

    private void OnPartyItemActionRequested(PartyItemRequest request)
    {
        if (_session?.Id != request.ChatId) return;
        var qty = request.Quantity > 1 ? $" ×{request.Quantity}" : "";
        var message = request.Action switch
        {
            "give" => Lang.T($"[ПЕРЕДАЧА ПРЕДМЕТА] Я предлагаю {request.Member} предмет «{request.ItemName}»{qty} (item_id={request.ItemId}). Отыграй реакцию спутника. Если он согласен и принимает вещь, вызови transfer_party_item с direction=hero_to_party, member={request.Member}, item_id={request.ItemId}, quantity={request.Quantity}, consent=true. Если откажется — ничего не перемещай.",
                $"[GIVING AN ITEM] I offer {request.Member} the item \"{request.ItemName}\"{qty} (item_id={request.ItemId}). Play out the companion's reaction. If they agree and accept it, call transfer_party_item with direction=hero_to_party, member={request.Member}, item_id={request.ItemId}, quantity={request.Quantity}, consent=true. If they refuse, move nothing."),
            "request" => Lang.T($"[ПРОСЬБА О ПРЕДМЕТЕ] Я прошу {request.Member} отдать мне «{request.ItemName}»{qty} (item_id={request.ItemId}). Отыграй решение спутника. Если он согласен, вызови transfer_party_item с direction=party_to_hero, member={request.Member}, item_id={request.ItemId}, quantity={request.Quantity}, consent=true. Если откажется — ничего не перемещай.",
                $"[ASKING FOR AN ITEM] I ask {request.Member} to give me \"{request.ItemName}\"{qty} (item_id={request.ItemId}). Play out the companion's decision. If they agree, call transfer_party_item with direction=party_to_hero, member={request.Member}, item_id={request.ItemId}, quantity={request.Quantity}, consent=true. If they refuse, move nothing."),
            _ => Lang.T($"[ИСПОЛЬЗОВАНИЕ РАСХОДНИКА] Я использую «{request.ItemName}» (item_id={request.ItemId}) из инвентаря героя на цели «{request.Target}». Определи и отыграй эффект по описанию предмета, сразу обнови HP/ману/щит/состояния цели соответствующим инструментом, затем вызови consume_item owner=hero, item_id={request.ItemId}, quantity=1. Не списывай предмет, если применить его невозможно.",
                $"[USING A CONSUMABLE] I use \"{request.ItemName}\" (item_id={request.ItemId}) from the hero's inventory on the target \"{request.Target}\". Determine and play out the effect from the item's description, immediately update the target's HP/mana/shield/conditions with the matching tool, then call consume_item owner=hero, item_id={request.ItemId}, quantity=1. Do not consume the item if it cannot be used."),
        };
        _ = InvokeAsync(async () => await SendTextAsync(message, clearDraft: false, ooc: false, kind: RequestKinds.Story));
    }

    private void OpenTrade(string npcName)
    {
        if (_session is not null && npcName.Length > 0)
        {
            Trade.Open(_session.Id, npcName);
        }
    }

    /// <summary>Итог сделки из окна торговли — отправляется мастеру, чтобы он отыграл реакцию торговца.</summary>
    private void OnTradeCompleted(string chatId, string summary)
    {
        if (_session?.Id != chatId || string.IsNullOrWhiteSpace(summary))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            if (_busy || _rolling)
            {
                _draft = summary;
                StateHasChanged();
                return;
            }

            await SendTextAsync(summary, clearDraft: false, ooc: false, kind: RequestKinds.Trade);
        });
    }

    /// <summary>Вид запроса: вне игры, создание мира, торговля, бой или обычная сцена.</summary>
    private string DetectKind(string sessionId, bool ooc, string? forced)
    {
        if (ooc)
        {
            return RequestKinds.Ooc;
        }

        if (forced is not null)
        {
            return forced;
        }

        if (FileToolsSvc.GetPhase(sessionId) != FileTools.CampaignPhase.Adventure)
        {
            return RequestKinds.World;
        }

        var state = RpgStore.GetOrCreate(sessionId);
        return state.Adversaries.Any(a => !string.IsNullOrWhiteSpace(a.Name) && (a.HpMax <= 0 || a.InFight))
            ? RequestKinds.Combat
            : RequestKinds.Story;
    }

    protected override void OnParametersSet()
    {
        _note = null;
        _ownArc = "";

        if (_diceChatId != Id)
        {
            // Чипы бросков живут в черновике конкретного чата — в другом чате их быть не должно.
            _diceChatId = Id;
            _pendingDice.Clear();
        }

        if (string.IsNullOrWhiteSpace(Id))
        {
            _session = null;
            return;
        }

        var session = Store.Get(Id);
        if (session is null)
        {
            _session = null;
            _note = Lang.T("Чат не найден (возможно, был удалён): ", "Chat not found (it may have been deleted): ") + Id;
            return;
        }

        _session = session;

        // Кампания другого сеттинга открывается только после смены темы: иначе мастер получит чужой промпт,
        // а книга героя — чужие каталоги предметов и портретов.
        var campaignGenre = Genre.Of(RpgStore.GetOrCreate(session.Id));
        _genreLock = campaignGenre != Genre.Current ? campaignGenre : null;
        if (_genreLock is not null)
        {
            return;
        }

        // Файлы кампании (Hero.md, World.md, Journal.md…) создаются, только если их ещё нет.
        RpgStore.EnsureCampaignFiles(session.Id);
        RefreshPhase();
    }

    private void RefreshPhase()
    {
        if (_session is not null)
        {
            _phase = FileToolsSvc.GetPhase(_session.Id);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_watched)
        {
            try
            {
                _self ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("harness.watchEnter", _self, _inputRef);
                await JS.InvokeVoidAsync("harness.watchChoiceKeys");
                _watched = true;
            }
            catch
            {
                // JS ещё недоступен (prerender / circuit переподключается) — попробуем в следующем рендере
            }
        }

        if (firstRender)
        {
            await ScrollToBottomAsync();
        }

        // Только что созданный герой: мастер сам открывает сессию ноль.
        if (_session is { } s && !_busy && s.Messages.Count == 0 && CreationFlow.TakeKickoff(s.Id))
        {
            _ = InvokeAsync(StartCampaignAsync);
        }
    }

    [JSInvokable]
    public Task HandleEnter() => SendAsync();

    /// <summary>Сеттинг открытой кампании, если он не совпадает с темой (тогда чат заблокирован).</summary>
    private string? _genreLock;

    /// <summary>Смена темы под сеттинг кампании и полная перезагрузка: каталоги и панели перечитываются заново.</summary>
    private async Task SwitchGenreAsync(string genre)
    {
        var stored = SettingsSvc.Clone();
        stored.Theme = UiThemes.Normalize(genre);
        SettingsSvc.Save(stored);
        try { await JS.InvokeVoidAsync("window.harness.setTheme", stored.Theme); } catch { }
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private Task NewChatAsync()
    {
        // Персонаж задаётся только при создании — открываем редактор героя.
        CreationFlow.Request();
        return Task.CompletedTask;
    }

    private Task StartCampaignAsync() => SendTextAsync(GmPrompt.Kickoff, clearDraft: false, hidden: true);

    // ===== Отправка сообщений =====

    private async Task SendAsync()
    {
        var draft = (_draft ?? "").Trim();
        if (draft.Length == 0 && _pendingDice.Count == 0 && _pendingImages.Count == 0)
        {
            return;
        }

        // Накопленные броски уезжают одной строкой перед текстом и убираются из черновика.
        var rolls = _pendingDice.ToList();
        _pendingDice.Clear();
        var line = rolls.Count == 0
            ? ""
            : "🎲 " + string.Join(", ", rolls.Select(r => $"{RollTitle(r.Kind)}: {r.Face}"));
        var text = line.Length == 0 ? draft : draft.Length == 0 ? line : $"{line}\n{draft}";
        await SendTextAsync(text, clearDraft: true, ooc: _asPlayer);
    }

    private void OwnArcKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _ = SendOwnArcAsync();
        }
    }

    private Task SendOwnArcAsync()
    {
        var text = _ownArc.Trim();
        if (text.Length == 0)
        {
            return Task.CompletedTask;
        }

        _ownArc = "";
        return SendTextAsync(Lang.T("Хочу свою арку: ", "I want my own arc: ") + text, clearDraft: false, ooc: false);
    }

    // ===== Прикрепление изображений (мультимодальность) =====

    private const int MaxImages = 4;
    private const long MaxImageBytes = 4 * 1024 * 1024;

    private async Task PickImages()
    {
        try
        {
            await JS.InvokeVoidAsync("harness.clickFileInput", _fileInputRef);
        }
        catch
        {
            // circuit разорван
        }
    }

    private async Task OnImagesChosen(ChangeEventArgs args)
    {
        if (args.Value is not System.Collections.IEnumerable files)
        {
            return;
        }

        foreach (var file in files)
        {
            if (_pendingImages.Count >= MaxImages)
            {
                break;
            }

            try
            {
                var dataUri = await JS.InvokeAsync<string>("harness.readFileAsDataUri", file, MaxImageBytes);
                if (!string.IsNullOrEmpty(dataUri))
                {
                    _pendingImages.Add(dataUri);
                }
            }
            catch (Exception ex)
            {
                _error = ex.Message;
            }
        }

        StateHasChanged();
    }

    private void RemoveImage(string dataUri)
    {
        _pendingImages.Remove(dataUri);
        StateHasChanged();
    }

    private async Task SendTextAsync(string text, bool clearDraft, bool hidden = false, bool ooc = false, string? kind = null)
    {
        if (_busy || _rolling || (string.IsNullOrEmpty(text) && _pendingImages.Count == 0) || _genreLock is not null)
        {
            return;
        }

        if (clearDraft)
        {
            _draft = "";
        }

        _error = null;

        if (_session is null)
        {
            _session = Store.Create();
            Nav.NavigateTo($"/chat/{_session.Id}");
        }

        var session = _session;

        var userMessage = new ChatMessage("user", text) { Hidden = hidden, Ooc = ooc };
        if (!hidden && _pendingImages.Count > 0)
        {
            userMessage.Images = _pendingImages.ToList();
            _pendingImages.Clear();
        }

        // Снимок книги героя до хода — для «Переиграть ход» / «Изменить ход».
        RpgStore.SaveSnapshot(session.Id, session.Messages.Count);

        var activeInstance = RpgStore.GetOrCreate(session.Id).ActiveInstance;
        if (!ooc && activeInstance is { Active: true })
        {
            userMessage.InstanceId = activeInstance.Id;
            activeInstance.Messages.Add(CopyMessage(userMessage));
            RpgStore.Save(session.Id, RpgStore.GetOrCreate(session.Id));
        }

        session.Messages.Add(userMessage);
        if (!hidden && session.Title is "Новый чат" or "New chat")
        {
            session.Title = string.IsNullOrWhiteSpace(text)
                ? Lang.T("Изображение", "Image")
                : text.Length <= 48 ? text : text[..48] + "…";
        }

        Store.Persist(session);
        Store.NotifyChanged();

        await RunTurnAsync(session, ooc, kind);
    }

    /// <summary>Ход мастера: агентный цикл «генерация → инструменты» по текущей истории.</summary>
    private async Task RunTurnAsync(ChatSession session, bool ooc, string? kind)
    {
        _error = null;
        var settings = SettingsSvc.Current;
        const bool toolsEnabled = true;
        var campaignDir = RpgStore.CampaignDirectory(session.Id) ?? settings.WorkDirectory;

        _busy = true;
        session.Busy = true;
        _cts = new CancellationTokenSource();
        // Сообщаем окну боя, что мастер занят («Рассказчик думает…»).
        Battle.SetStatus(session.Id, kind == RequestKinds.Combat
            ? Lang.T("Рассказчик обдумывает ход…", "The narrator is planning the turn…")
            : Lang.T("Рассказчик думает…", "The narrator is thinking…"));
        Battle.SetStream(session.Id, "");
        StateHasChanged();
        await ScrollToBottomAsync();

        ChatMessage NewReply()
        {
            var instance = !ooc ? RpgStore.GetOrCreate(session.Id).ActiveInstance : null;
            return new ChatMessage("assistant", "") { Ooc = ooc, InstanceId = instance is { Active: true } ? instance.Id : null };
        }

        var reply = NewReply();
        session.Messages.Add(reply);
        Battle.SetStream(session.Id, "");
        Store.Persist(session);
        var keepReasoning = settings.ReasoningEnabled && settings.ReasoningFormat == "deepseek";
        var turnUsage = new TokenUsageStats();

        void OnProgress(StreamProgress progress)
        {
            _progress = progress;
            _ = InvokeAsync(StateHasChanged);
        }

        void OnDelta(string delta)
        {
            _progress = null;
            reply.Content += delta;
            // Тот же текст, что печатается в чате, уходит в окно боя — оно показывает его потоком с той же кареткой.
            Battle.SetStream(session.Id, reply.Content);
            _ = InvokeAsync(async () =>
            {
                StateHasChanged();
                await ScrollToBottomAsync();
            });
        }

        try
        {
            // Агентный цикл: генерация → вызовы инструментов → результаты → генерация…
            var round = 0;
            var pendingRecoveryNote = "";
            var recoveryAttempts = 0;
            var phaseRecoveryAttempts = 0;
            var incompleteResponseAttempts = 0;
            var previousToolErrors = new List<string>();
            while (true)
            {
                round++;
                var state = RpgStore.GetOrCreate(session.Id);
                var activeBefore = !ooc && state.ActiveInstance is { Active: true }
                    ? state.ActiveInstance
                    : null;
                var sourceHistory = activeBefore is not null
                    ? activeBefore.Messages.ToList()
                    : session.Messages.Where(m => string.IsNullOrEmpty(m.InstanceId)).ToList();
                var history = LlmClient.TrimHistory(sourceHistory, settings.HistoryLimit, out var limited);
                var stateNote = toolsEnabled
                    ? FileToolsSvc.BuildStateNote(session.Id, limited ? RpgStore.ReadJournalTail(session.Id, 2500) : null)
                    : null;
                if (ooc && state.ActiveInstance is { Active: true } pausedInstance && stateNote is not null)
                {
                    stateNote += Lang.T($"\n\nВНЕИГРОВОЙ ВОПРОС: отвечай как основной Мастер. Инстанс «{pausedInstance.Title}» временно приостановлен; не добавляй этот разговор в его историю и не завершай его без просьбы игрока.",
                        $"\n\nOUT-OF-GAME QUESTION: answer as the main Master. The instance \"{pausedInstance.Title}\" is paused for now; do not add this conversation to its history and do not finish it unless the player asks.");
                }
                var reservedChars = LlmClient.ReservedChars(
                    settings, stateNote, toolsEnabled ? FileToolsSvc.DefinitionsChars : 0);
                history = LlmClient.FitHistoryToContext(history, settings, reservedChars, out var compressed);
                if (compressed && toolsEnabled && !limited)
                {
                    stateNote = FileToolsSvc.BuildStateNote(session.Id, RpgStore.ReadJournalTail(session.Id, 2500));
                }
                if (!string.IsNullOrWhiteSpace(pendingRecoveryNote))
                {
                    stateNote = (stateNote ?? "") + "\n\n" + pendingRecoveryNote;
                    pendingRecoveryNote = "";
                }

                _progress = null;
                // Вид запроса пересчитывается каждый раунд: бой может начаться посреди хода мастера.
                _kind = DetectKind(session.Id, ooc, kind);
                var profile = settings.ProfileFor(_kind);
                var turn = await Llm.StreamChatAsync(settings, history, OnDelta, toolsEnabled, _cts.Token, stateNote, OnProgress, profile);
                turnUsage.Add(turn.Usage);
                _progress = null;

                // Некоторые совместимые API завершают поток с finish_reason=tool_calls, хотя
                // arguments оборвались посреди JSON. Не показываем и не исполняем такой вызов:
                // повторяем генерацию в рамках того же хода с явным указанием причины.
                if (turn.ToolCalls.Count > 0 && LlmClient.HasInvalidToolArguments(turn) &&
                    incompleteResponseAttempts < 2 && round < MaxToolRounds)
                {
                    incompleteResponseAttempts++;
                    pendingRecoveryNote = Lang.T(
                        "СЛУЖЕБНОЕ ВОССТАНОВЛЕНИЕ: предыдущий поток завершился с оборванными аргументами инструмента. Повтори нужный вызов заново одним коротким, полным JSON-объектом. Не продолжай прежний фрагмент и не повторяй уже показанный игроку текст.",
                        "RECOVERY NOTE: the previous stream ended with truncated tool arguments. Repeat the required call from scratch as one short, complete JSON object. Do not continue the old fragment or repeat text already shown to the player.");
                    session.Messages.Remove(reply);
                    reply = NewReply();
                    session.Messages.Add(reply);
                    continue;
                }

                if (turn.ToolCalls.Count == 0)
                {
                    // EOF без текста, инструмента и явной отмены — тоже повреждённый ответ API.
                    if (string.IsNullOrWhiteSpace(turn.Content) && incompleteResponseAttempts < 2 &&
                        round < MaxToolRounds)
                    {
                        incompleteResponseAttempts++;
                        pendingRecoveryNote = Lang.T(
                            "СЛУЖЕБНОЕ ВОССТАНОВЛЕНИЕ: API завершил предыдущий поток без текста и без вызова инструмента. Повтори ответ полностью и обязательно заверши ход текстом либо корректным вызовом инструмента.",
                            "RECOVERY NOTE: the API ended the previous stream without text or a tool call. Repeat the response in full and finish the turn with either text or a valid tool call.");
                        session.Messages.Remove(reply);
                        reply = NewReply();
                        session.Messages.Add(reply);
                        continue;
                    }

                    // Некоторые совместимые модели после ошибки инструмента возвращают пустой ответ.
                    // Делаем до двух внутренних попыток продолжить, вместо молчаливой остановки хода.
                    if (string.IsNullOrWhiteSpace(turn.Content) && previousToolErrors.Count > 0 &&
                        recoveryAttempts < 2 && round < MaxToolRounds)
                    {
                        recoveryAttempts++;
                        pendingRecoveryNote = Lang.T(
                            "СЛУЖЕБНОЕ ВОССТАНОВЛЕНИЕ: предыдущий инструмент завершился ошибкой, а твой следующий ответ оказался пустым. Не останавливайся. Исправь вызов инструмента либо объясни ситуацию игроку и обязательно продолжи ход. Ошибки: " + string.Join(" | ", previousToolErrors),
                            "RECOVERY NOTE: the previous tool failed and your next response was empty. Do not stop. Correct the tool call or explain the situation to the player and continue the turn. Errors: " + string.Join(" | ", previousToolErrors));
                        session.Messages.Remove(reply);
                        reply = NewReply();
                        session.Messages.Add(reply);
                        continue;
                    }

                    // На этапах настройки мира текстовый вопрос без карточек выглядит как зависание:
                    // игроку нечего нажать, а фаза не продвигается. Один раз просим модель дослать
                    // обязательный инструмент, не повторяя уже показанный текст.
                    var phase = !ooc ? FileToolsSvc.GetPhase(session.Id) : FileTools.CampaignPhase.Adventure;
                    if (!string.IsNullOrWhiteSpace(turn.Content) && !ooc &&
                        phase is FileTools.CampaignPhase.SessionZero or FileTools.CampaignPhase.ArcChoice &&
                        phaseRecoveryAttempts < 1 && round < MaxToolRounds)
                    {
                        phaseRecoveryAttempts++;
                        pendingRecoveryNote = phase == FileTools.CampaignPhase.SessionZero
                            ? Lang.T(
                                "СЛУЖЕБНОЕ ВОССТАНОВЛЕНИЕ: ты закончил вопросом на сессии ноль, но не вызвал offer_choices. Не повторяй уже показанный текст; сейчас вызови offer_choices с 2–4 короткими вариантами ответа игрока.",
                                "RECOVERY NOTE: you ended with a session-zero question but did not call offer_choices. Do not repeat the text already shown; call offer_choices now with 2–4 short player answers.")
                            : Lang.T(
                                "СЛУЖЕБНОЕ ВОССТАНОВЛЕНИЕ: этап выбора арки нельзя завершать одним текстом. Не повторяй уже показанный текст; сейчас вызови propose_arcs либо, если игрок уже выбрал, update_arc и продолжи.",
                                "RECOVERY NOTE: the arc-choice stage cannot end with text alone. Do not repeat the text already shown; call propose_arcs now, or if the player has already chosen, call update_arc and continue.");
                        Store.Persist(session);
                        reply = NewReply();
                        session.Messages.Add(reply);
                        continue;
                    }

                    if (string.IsNullOrWhiteSpace(turn.Content))
                    {
                        throw new InvalidOperationException(Lang.T(
                            "API несколько раз завершил генерацию без ответа. Повторите ход; если это повторяется, уменьшите глубину рассуждений для этого типа запроса.",
                            "The API ended generation without a response several times. Retry the turn; if this keeps happening, reduce the reasoning effort for this request type."));
                    }

                    if (activeBefore is not null)
                    {
                        activeBefore.Messages.Add(new ChatMessage("assistant", turn.Content)
                        {
                            Ooc = ooc,
                            InstanceId = activeBefore.Id,
                            Reasoning = keepReasoning ? turn.Reasoning : null,
                        });
                        RpgStore.Save(session.Id, state);
                    }
                    break; // финальный текстовый ответ
                }

                reply.ToolCalls = turn.ToolCalls.ToList();
                if (keepReasoning && turn.Reasoning.Length > 0)
                {
                    reply.Reasoning = turn.Reasoning;
                }

                foreach (var call in reply.ToolCalls)
                {
                    // Инструмент изменяет состояние атомарно: во время его короткого синхронного
                    // выполнения кнопка остановки отключена, чтобы не обещать ложную отмену.
                    _cts.Token.ThrowIfCancellationRequested();
                    _executingTool = true;
                    await InvokeAsync(StateHasChanged);
                    (bool ok, string result) toolResult;
                    try
                    {
                        toolResult = await Task.Run(
                            () => FileToolsSvc.Execute(campaignDir, call.Name, call.Arguments, session.Id));
                    }
                    finally
                    {
                        _executingTool = false;
                        await InvokeAsync(StateHasChanged);
                    }
                    var (ok, result) = toolResult;
                    call.Ok = ok;
                    call.Result = result;
                    // Боевой журнал: кто кого ударил, вылечил, наложил или снял эффект.
                    BattleLogFeed.Feed(BattleLogSvc, session.Id, call,
                        RpgStore.GetOrCreate(session.Id).InCombat());
                    if (ok && call.Name == "open_trade" && S(Args(call), "npc") is { Length: > 0 } merchant)
                    {
                        Trade.Open(session.Id, merchant);
                    }
                    if (ok && call.Name == "open_adventure_guild" && S(Args(call), "city") is { Length: > 0 } guildCity)
                    {
                        Guild.Open(session.Id, guildCity);
                    }
                    if (ok && call.Name == "update_adversary" && Args(call)["remove"]?.GetValue<bool>() != true) Battle.Open(session.Id);
                    if (ok && call.Name == "plan_encounter" && Args(call)["spawn"]?.ToString() != "false") Battle.Open(session.Id);
                    _ = InvokeAsync(async () =>
                    {
                        StateHasChanged();
                        await ScrollToBottomAsync();
                    });
                }

                previousToolErrors = reply.ToolCalls
                    .Where(c => c.Ok == false)
                    .Select(c => $"{c.Name}: {c.Result}")
                    .ToList();
                if (previousToolErrors.Count == 0)
                {
                    recoveryAttempts = 0;
                }

                if (activeBefore is not null)
                {
                    activeBefore.Messages.Add(new ChatMessage("assistant", turn.Content)
                    {
                        Ooc = ooc,
                        InstanceId = activeBefore.Id,
                        Reasoning = keepReasoning ? turn.Reasoning : null,
                        ToolCalls = reply.ToolCalls,
                    });
                    RpgStore.Save(session.Id, state);
                }

                // После start_instance последующие реплики принадлежат суб-мастеру; после finish_instance — снова основному.
                if (reply.ToolCalls.Any(c => c.Ok == true && c.Name == "start_instance") && state.ActiveInstance is { Active: true } started)
                {
                    reply.InstanceId = null; // служебная передача остаётся в основной истории
                }

                Store.Persist(session);
                Store.NotifyChanged();

                // Кнопки выбора показаны — ход мастера окончен, ждём игрока.
                if (reply.ToolCalls.Any(c => c.Ok == true && FileTools.WaitForPlayerTools.Contains(c.Name)))
                {
                    break;
                }

                if (round >= MaxToolRounds)
                {
                    reply.Content += Lang.T("\n\n_(достигнут лимит последовательных вызовов инструментов — остановлено)_", "\n\n_(the limit of consecutive tool calls was reached — stopped)_");
                    break;
                }

                // Следующий раунд: новая пустая реплика мастера.
                reply = NewReply();
                session.Messages.Add(reply);
                Battle.SetStream(session.Id, "");
            }
        }
        catch (OperationCanceledException)
        {
            if (reply.Content.Length == 0 && reply.ToolCalls is not { Count: > 0 })
            {
                session.Messages.Remove(reply);
            }
            else
            {
                reply.Content += Lang.T("\n\n_(остановлено)_", "\n\n_(stopped)_");
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            if (reply.Content.Length == 0 && reply.ToolCalls is not { Count: > 0 })
            {
                session.Messages.Remove(reply);
            }
            else
            {
                reply.Content += Lang.T($"\n\n_(ошибка: {ex.Message})_", $"\n\n_(error: {ex.Message})_");
            }
        }
        finally
        {
            // Пустая последняя реплика (модель закончила ход вызовом инструмента) не нужна.
            if (reply.Content.Length == 0 && reply.ToolCalls is not { Count: > 0 })
            {
                session.Messages.Remove(reply);
            }

            _busy = false;
            _executingTool = false;
            _kind = null;
            _progress = null;
            session.Busy = false;
            session.LastTurnUsage = turnUsage;
            session.TotalUsage ??= new TokenUsageStats();
            session.TotalUsage.Add(turnUsage);
            Battle.SetStatus(session.Id, "");
            Battle.SetStream(session.Id, "");
            Store.Persist(session);
            Store.NotifyChanged();
            _cts?.Dispose();
            _cts = null;
            RefreshPhase();

            await InvokeAsync(async () =>
            {
                StateHasChanged();
                await ScrollToBottomAsync();
                try
                {
                    await JS.InvokeVoidAsync("harness.focusEl", _inputRef);
                }
                catch
                {
                    // circuit уже закрыт
                }
            });
        }
    }

