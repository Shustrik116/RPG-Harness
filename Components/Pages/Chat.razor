    private static System.Text.Json.Nodes.JsonObject Args(ToolCall call)
    {
        try
        {
            return System.Text.Json.Nodes.JsonNode.Parse(string.IsNullOrWhiteSpace(call.Arguments) ? "{}" : call.Arguments)
                as System.Text.Json.Nodes.JsonObject ?? new();
        }
        catch
        {
            return new();
        }
