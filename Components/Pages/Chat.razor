    // ===== Откат хода =====

    /// <summary>Индекс последнего сообщения игрока в полной истории (включая скрытые).</summary>
    private int LastUserIndex => _session?.Messages.FindLastIndex(m => m.Role == "user") ?? -1;

    /// <summary>Есть что переиграть: после последней реплики игрока уже есть ответ мастера и снимок книги героя.</summary>
    private bool CanRewind
    {
        get
        {
            var idx = LastUserIndex;
            return _session is { } s && idx >= 0 && idx < s.Messages.Count - 1 && RpgStore.HasSnapshot(s.Id, idx);
        }
    }

    /// <summary>Последнюю реплику можно вернуть в поле ввода (скрытые служебные — нельзя).</summary>
    private bool CanEditLast => _session is { } s && LastUserIndex is var i && i >= 0 && !s.Messages[i].Hidden;

    /// <summary>Откатывает книгу героя и историю к моменту перед ответом мастера на последнюю реплику.</summary>
    private ChatMessage? RewindLastTurn(bool dropUserMessage)
    {
        if (_session is not { } s || _busy || _rolling)
        {
            return null;
        }

        var idx = LastUserIndex;
        if (idx < 0 || !RpgStore.RestoreSnapshot(s.Id, idx))
        {
            _error = Lang.T("Не удалось откатить ход: нет снимка книги героя.", "Could not roll back the turn: there is no snapshot of the hero book.");
            return null;
        }

        var user = s.Messages[idx];
        var from = dropUserMessage ? idx : idx + 1;
        s.Messages.RemoveRange(from, s.Messages.Count - from);
        Store.Persist(s);
        Store.NotifyChanged();
        RefreshPhase();
        return user;
    }

    private async Task RegenerateAsync()
    {
        var user = RewindLastTurn(dropUserMessage: false);
        if (user is null || _session is null)
        {
            return;
        }

        var kind = IsTradeReceipt(user.Content) ? RequestKinds.Trade : null;
        // Снимок остаётся прежним — переигрывать можно сколько угодно раз.
        await RunTurnAsync(_session, user.Ooc, kind);
    }

    private async Task EditLastAsync()
    {
        var user = RewindLastTurn(dropUserMessage: true);
        if (user is null)
        {
            return;
        }

        _draft = user.Content;
        _mode = user.Ooc ? "player" : "hero";
        if (user.Images is { Count: > 0 } imgs)
        {
            _pendingImages.Clear();
            _pendingImages.AddRange(imgs);
        }

        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("harness.focusEl", _inputRef);
        }
        catch
        {
            // circuit закрыт
        }
    }

