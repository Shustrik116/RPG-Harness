                                                {
                                                    <button class="arc-pick" @onclick="() => SendTextAsync(chosen.PickMessage, clearDraft: false, ooc: false)">@Lang.T("Выбрать эту историю", "Choose this story")</button>
                                                }
                                            </div>
                                        }
                                    </div>
                                    @if (isActive)
                                    {
                                        <div class="arc-own">
                                            <input class="arc-own-in" placeholder="@Lang.T("Свой вариант: о чём должна быть история…", "Your own idea: what should the story be about…")"
                                                   @bind="_ownArc" @bind:event="oninput" @onkeydown="OwnArcKeyDown" />
                                            <button class="arc-pick" disabled="@string.IsNullOrWhiteSpace(_ownArc)" @onclick="SendOwnArcAsync">@Lang.T("Предложить", "Propose")</button>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                }

                @if (_busy)
                {
                    var tail = visible.Count > 0 ? visible[^1] : null;
                    var waiting = tail is null || tail.Role != "assistant" || (string.IsNullOrEmpty(tail.Content) && tail.ToolCalls is not { Count: > 0 });
                    var progress = ProgressText;
                    @if (waiting || progress is not null)
