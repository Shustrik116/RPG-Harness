                    <div class="turn-tools">
                        <button class="turn-tool" title="@Lang.T("Откатить книгу героя к началу хода и заново сгенерировать ответ мастера", "Roll the hero book back to the start of the turn and regenerate the master's reply")" @onclick="RegenerateAsync">
                            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8a5 5 0 1 1-1.6-3.7M13 2.5v3h-3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
