                    </div>
                    <div class="composer-right">
                        <label class="mode-wrap" title="@Lang.T("Персонаж — действия и слова героя в игре. Игрок — разговор с мастером вне игры: обсудить, оспорить, уточнить.", "Character — the hero's actions and words in the game. Player — a talk with the master out of game: discuss, dispute, clarify.")">
                            <select class="mode-select" @bind="_mode">
                                <option value="hero">@Lang.T("Персонаж", "Character")</option>
                                <option value="player">@Lang.T("Игрок", "Player")</option>
                            </select>
                        </label>
                        @if (_busy)
                        {
                            <button class="btn-stop" disabled="@_executingTool" @onclick="Stop"
                                    title="@(_executingTool ? Lang.T("Текущее действие мастера атомарно и будет завершено", "The master's current action is atomic and will finish") : Lang.T("Остановить генерацию", "Stop generation"))">
                                <span class="btn-stop-sq" aria-hidden="true"></span> @(_executingTool ? Lang.T("Действие…", "Acting…") : Lang.T("Стоп", "Stop"))
                            </button>
