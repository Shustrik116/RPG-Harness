@page "/"
@page "/chat/{Id?}"
@implements IDisposable
@using Markdig
@inject ChatStore Store
@inject SettingsService SettingsSvc
@inject RpgStateStore RpgStore
@inject FileTools FileToolsSvc
@inject LlmClient Llm
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ChatCreationFlow CreationFlow
@inject TradeFlow Trade
@inject GuildFlow Guild
@inject BattleFlow Battle
@inject BattleLog BattleLogSvc
@inject PartyFlow PartyFlow
@inject TalkFlow Talk

<PageTitle>@(_session?.Title ?? Lang.T("Чат", "Chat")) — RPG Harness</PageTitle>

<div class="chat-shell">
    <header class="chat-header">
        <div class="ch-left">
            <div class="ch-title">@(_session?.Title ?? "RPG Harness")</div>
            @if (_session is not null)
            {
                <ol class="ch-steps" title="@Lang.T("Этап кампании", "Campaign stage")">
                    @for (var p = 0; p < PhaseTitles.Length; p++)
                    {
                        var state = p < PhaseIndex ? "done" : p == PhaseIndex ? "now" : "";
                        <li class="@state">@PhaseTitles[p]</li>
                    }
                </ol>
            }
        </div>
        <div class="ch-right">
            @if (_session is not null && RpgStore.GetOrCreate(_session.Id).ActiveInstance is { Active: true } activeInstance)
            {
                <span class="ch-instance" title="@Lang.T("Эта замкнутая сцена ведётся в отдельном контексте, но остаётся частью той же кампании", "This self-contained scene runs in a separate context but remains part of the same campaign")">⚔ @activeInstance.Title</span>
            }
            @if (_busy && _kind is not null)
            {
                var prof = SettingsSvc.Current.ProfileFor(_kind);
                <span class="ch-kind kind-@_kind" title="@Lang.T("Профиль запроса: температура и глубина рассуждений (Настройки)", "Request profile: temperature and reasoning depth (Settings)")">
                    @RequestKinds.TitleOf(_kind)<span class="ch-kind-num">@(prof.Temperature is { } t ? $"t {t:0.##}" : "")@(SettingsSvc.Current.ReasoningEnabled && prof.Effort.Length > 0 ? $" · {prof.Effort}" : "")</span>
                </span>
            }
            @if (string.IsNullOrWhiteSpace(SettingsSvc.Current.WorkDirectory))
            {
                <span class="ch-warn" title="@Lang.T("Чаты и кампания не сохраняются на диск, пока не выбрана рабочая директория", "Chats and the campaign are not saved to disk until a working directory is chosen")">@Lang.T("не сохраняется", "not saved")</span>
            }
            <span class="ch-model" title="@Lang.T("Используемая модель", "The model in use")">@SettingsSvc.Current.Model</span>
            <button class="ch-book @(_panelOpen ? "is-open" : "")"
                    title="@Lang.T("Книга героя: персонаж, снаряжение, NPC, задания", "Hero book: character, gear, NPCs, quests")"
                    @onclick="TogglePanel">
                <svg viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M3 4.2c2.3-.9 4.6-.9 7 .6 2.4-1.5 4.7-1.5 7-.6v11.6c-2.3-.9-4.6-.9-7 .6-2.4-1.5-4.7-1.5-7-.6Z M10 4.8v11.6"
                          fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                </svg>
                <span>@Genre.PickT("Книга героя", "Досье", "Личное дело", "Hero book", "Dossier", "Personal file")</span>
            </button>
        </div>
    </header>

    <div class="chat-log" @ref="_logRef">
        <div class="chat-stream">
            @if (_session is null)
            {
                <div class="welcome">
                    <svg class="welcome-mark" viewBox="0 0 32 32" aria-hidden="true">
                        <path d="M16 2.5 28 9.5v13L16 29.5 4 22.5v-13Z" fill="none" stroke="currentColor" stroke-width="1" />
                        <path d="M16 2.5 10 20h12Z M4 9.5 10 20 M28 9.5 22 20 M10 20 16 29.5 22 20 M4 22.5 10 20 M28 22.5 22 20"
                              fill="none" stroke="currentColor" stroke-width=".7" opacity=".6" />
                    </svg>
                    <h1 class="welcome-title">@Genre.PickT("Каждая история начинается с героя", "Ночной город ждёт героя", "Город не спит. Нужен герой", "Every story begins with a hero", "The night city awaits a hero", "The city never sleeps. It needs a hero")</h1>
                    <p class="welcome-lead">
                        @Genre.PickT("Нейросеть-мастер расспросит, какой мир вам по душе, сотворит его, предложит сюжетные арки и поведёт игру — честно бросая кости и записывая всё в книгу героя.",
                            "Нейросеть-мастер расспросит, какой город вам по душе, соберёт его — корпорации, банды, неон и сеть, — предложит сюжетные арки и поведёт игру, честно бросая кости и записывая всё в досье.", "Нейросеть-мастер расспросит, какая история вам по душе — криминал, боевик, расследование, выживание, — соберёт город и людей, предложит сюжетные арки и поведёт игру, честно бросая кости и записывая всё в личное дело.",
                            "The AI game master will ask what kind of world you like, create it, offer story arcs and run the game — rolling the dice fairly and recording everything in the hero book.",
                            "The AI game master will ask what kind of city you like, build it — corporations, gangs, neon and the net — offer story arcs and run the game, rolling the dice fairly and recording everything in the dossier.",
                            "The AI game master will ask what kind of story you like — crime, action, investigation, survival — build the city and its people, offer story arcs and run the game, rolling the dice fairly and recording everything in the personal file.")
                    </p>
                    @if (_welcomeHint is not null)
                    {
                        <p class="welcome-hint">@_welcomeHint <a href="/settings">@Lang.T("Настройки", "Settings")</a></p>
                    }
                    <div class="welcome-actions">
                        <button class="btn btn-primary" @onclick="NewChatAsync">@Lang.T("Создать героя", "Create a hero")</button>
                        <a class="btn btn-outline" href="/settings">@Lang.T("Настройки", "Settings")</a>
                    </div>
                    <ol class="welcome-steps">
                        <li><b>@Lang.T("Герой", "Hero")</b><span>@Genre.PickT("имя, раса, класс, характеристики", "имя, происхождение, класс, характеристики", "имя, прошлое, профессия, характеристики", "name, race, class, ability scores", "name, origin, class, ability scores", "name, background, profession, ability scores")</span></li>
                        <li><b>@Genre.PickT("Мир", "Город", "Обстановка", "World", "City", "Setting")</b><span>@Genre.PickT("жанр, тон и правила — на ваш вкус", "оттенок, тон и правила — на ваш вкус", "город, жанр и правила — на ваш вкус", "genre, tone and rules — to your taste", "flavor, tone and rules — to your taste", "city, genre and rules — to your taste")</span></li>
                        <li><b>@Lang.T("Арка", "Arc")</b><span>@Lang.T("выбор сюжета из 3–5 завязок", "pick a plot from 3–5 hooks")</span></li>
                        <li><b>@Lang.T("Игра", "Play")</b><span>@Genre.PickT("кости, бои, торговля, NPC", "кости, перестрелки, взломы, сделки", "кости, перестрелки, погони, сделки", "dice, fights, trading, NPCs", "dice, shootouts, hacks, deals", "dice, shootouts, chases, deals")</span></li>
                    </ol>
                </div>
            }
            else if (_genreLock is { } lockedGenre)
            {
                <div class="welcome genre-lock">
                    <h1 class="welcome-title">@Lang.T("Кампания из другого мира", "A campaign from another world")</h1>
                    <p class="welcome-lead">
                        @Lang.T($"«{_session.Title}» создана в сеттинге «{Genre.Title(lockedGenre)}», а сейчас выбрана тема «{Genre.Title(Genre.Current)}». У каждого сеттинга свой мастер, предметы и враги, поэтому кампания открывается только в своей теме.",
                                $"\"{_session.Title}\" was created in the \"{Genre.Title(lockedGenre)}\" setting, but the \"{Genre.Title(Genre.Current)}\" theme is selected now. Each setting has its own master, items and enemies, so a campaign opens only in its own theme.")
                    </p>
                    <div class="welcome-actions">
                        <button class="btn btn-primary" @onclick="() => SwitchGenreAsync(lockedGenre)">@Lang.T($"Переключить на «{Genre.Title(lockedGenre)}»", $"Switch to \"{Genre.Title(lockedGenre)}\"")</button>
                        <a class="btn btn-outline" href="/">@Lang.T($"Остаться в «{Genre.Title(Genre.Current)}»", $"Stay in \"{Genre.Title(Genre.Current)}\"")</a>
                    </div>
                </div>
            }
            else
            {
                var visible = _session.Messages.Where(m => !m.Hidden).ToList();
                var lastUserIdx = visible.FindLastIndex(m => m.Role == "user");
                // Вопрос вне роли не должен поглощать последний игровой выбор героя.
                var lastHeroActionIdx = visible.FindLastIndex(m => m.Role == "user" && !m.Ooc);

                @if (visible.Count == 0 && !_busy)
                {
                    <div class="welcome welcome-table">
                        <h1 class="welcome-title">@Lang.T("Мастер ждёт за столом", "The master is waiting at the table")</h1>
                        <p class="welcome-lead">
                            @Genre.PickT("Он поприветствует героя и расспросит, какой мир, жанр и правила вам по душе.", "Он поприветствует героя и расспросит, какой город, оттенок и правила вам по душе.", "Он поприветствует героя и расспросит, где и когда происходит история, какой у неё жанр и правила.",
                                "They will greet the hero and ask what world, genre and rules you like.", "They will greet the hero and ask what city, flavor and rules you like.", "They will greet the hero and ask where and when the story takes place, its genre and rules.")
                            @Lang.T("Можно и сразу написать свою идею кампании в поле ниже.", "You can also type your own campaign idea in the field below right away.")
                        </p>
                        <div class="welcome-actions">
                            <button class="btn btn-primary" @onclick="StartCampaignAsync">@Lang.T("Начать кампанию", "Start the campaign")</button>
                        </div>
                    </div>
                }

                @for (var i = 0; i < visible.Count; i++)
                {
                    var message = visible[i];
                    var isActive = i > (message.Ooc ? lastUserIdx : lastHeroActionIdx) && !_busy;
                    var continues = i > 0 && visible[i - 1].Role == message.Role && visible[i - 1].Ooc == message.Ooc;
                    var calls = message.ToolCalls ?? new List<ToolCall>();
                    var bookCalls = calls.Where(c => c.Name is not ("roll_dice" or "offer_choices" or "propose_arcs" or "open_trade" or "travel" or "buy_rumors" or "ask_companion_role")).ToList();
                    var streaming = _busy && i == visible.Count - 1 && message.Role == "assistant";

                    @if (message.Role == "user" && i > 0 && !continues)
                    {
                        <div class="turn-rule" aria-hidden="true"><i></i></div>
                    }

                    @if (message.Role == "user")
                    {
                        var view = UserView(message.Content);
                        <div class="msg hero @(continues ? "cont" : "") @(message.Ooc ? "ooc" : "")">
                            @if (!continues)
                            {
                                <div class="who">@(message.Ooc ? Lang.T("Игрок · вне игры", "Player · out of game") : HeroName)</div>
                            }
                            @switch (view.Kind)
                            {
                                case "roll":
                                    <div class="hero-roll">
                                        <span class="hero-roll-die">@view.Label</span>
                                        <span class="hero-roll-val">@view.Value</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(view.Text))
                                    {
                                        <div class="hero-line">@((MarkupString)Plain(view.Text))</div>
                                    }
                                    break;
                                case "receipt":
                                    <div class="hero-receipt">
                                        <span class="hero-receipt-tag">@Lang.T("Сделка", "Deal")</span>
                                        <span>@view.Text</span>
                                    </div>
                                    break;
                                default:
                                    <div class="hero-line">@((MarkupString)Plain(message.Content))</div>
                                    break;
                            }
                            @if (message.HasImages)
                            {
                                <div class="msg-images">
                                    @foreach (var img in message.Images!)
                                    {
                                        <img class="msg-image" src="@img" alt="@Lang.T("прикреплённое изображение", "attached image")" />
                                    }
                                </div>
                            }
                        </div>
                        continue;
                    }

                    <div class="msg gm @(continues ? "cont" : "") @(message.Ooc ? "ooc" : "") @(streaming ? "is-streaming" : "")">
                        @if (message.Ooc && !continues)
                        {
                            <div class="who">@Lang.T("Мастер · вне игры", "Master · out of game")</div>
                        }

                        @if (!string.IsNullOrEmpty(message.Content))
                        {
                            <div class="prose">@((MarkupString)RenderMd(message.Content))</div>
                        }

                        @foreach (var trip in calls.Where(c => c.Name == "travel" && c.Ok == true))
                        {
                            var meta = TravelEncounters.ParseMeta(trip.Result);
                            @if (meta is not null && meta.Spins.Count > 0)
                            {
                                var animate = i > lastUserIdx;
                                <div class="wheel @(animate ? "is-fresh" : "")">
                                    <div class="wheel-head">
                                        <span class="wheel-kicker">@Genre.PickT("Колесо дороги", "Колесо улиц", "Колесо дороги", "Road wheel", "Street wheel", "Road wheel")</span>
                                        <span class="wheel-route">@meta.From <i>→</i> @meta.To</span>
                                        <span class="wheel-dist">@TravelEncounters.DistanceTitle(meta.Distance)</span>
                                    </div>
                                    @for (var s = 0; s < meta.Spins.Count; s++)
                                    {
                                        var spin = meta.Spins[s];
                                        <div class="wheel-row @(spin.Event ? $"is-event tier-{spin.Tier}" : "is-quiet")" style="--delay:@(s * 0.7)s; --n:@spin.Reel.Count">
                                            <div class="wheel-window" aria-hidden="true">
                                                <div class="wheel-reel">
                                                    @foreach (var face in spin.Reel)
                                                    {
                                                        <span>@face</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="wheel-result">
                                                <span class="wheel-d100" title="@Lang.T($"Бросок d100: 1–{TravelEncounters.QuietChance} — спокойно, выше — событие", $"d100 roll: 1–{TravelEncounters.QuietChance} — calm, higher — an event")">d100 <b>@spin.D100</b></span>
                                                <span class="wheel-tier">@(spin.Event ? TravelEncounters.TierTitle(spin.Tier ?? "") : Lang.T("спокойно", "calm"))</span>
                                                @if (spin.Event && spin.Loot != "none")
                                                {
                                                    <span class="wheel-loot rar-@spin.Loot">@Lang.T("добыча:", "loot:") @TravelEncounters.LootTitle(spin.Loot).ToLowerInvariant()</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }

                        @foreach (var rumorCall in calls.Where(c => c.Name == "buy_rumors" && c.Ok == true))
                        {
                            var rumorMeta = RumorWheel.ParseMeta(rumorCall.Result);
                            @if (rumorMeta is not null && rumorMeta.Spins.Count > 0)
                            {
                                var animate = i > lastUserIdx;
                                <div class="wheel rumor-wheel @(animate ? "is-fresh" : "")">
                                    <div class="wheel-head"><span class="wheel-kicker">@Genre.PickT("Колесо слухов", "Колесо информации", "Колесо слухов", "Rumor wheel", "Intel wheel", "Rumor wheel")</span><span class="wheel-route">@Lang.T("Источник:", "Source:") @rumorMeta.Source</span><span class="wheel-dist">65 / 27 / 8</span></div>
                                    @for (var s = 0; s < rumorMeta.Spins.Count; s++)
                                    {
                                        var spin = rumorMeta.Spins[s];
                                        <div class="wheel-row is-event rumor-tier-@spin.Tier" style="--delay:@(s * 0.7)s; --n:@spin.Reel.Count">
                                            <div class="wheel-window" aria-hidden="true"><div class="wheel-reel">@foreach (var face in spin.Reel) { <span>@face</span> }</div></div>
                                            <div class="wheel-result"><span class="wheel-d100" title="@Lang.T("1–65: малая зацепка; 66–92: средний квест; 93–100: длинный квест", "1–65: a small lead; 66–92: a medium quest; 93–100: a long quest")">d100 <b>@spin.D100</b></span><span class="wheel-tier">@RumorWheel.Title(spin.Tier)</span></div>
                                        </div>
                                    }
                                    <div class="rumor-linked">@Lang.T("Один дополнительный слух гарантированно связан с текущей аркой или заданием.", "One extra rumor is guaranteed to be linked to the current arc or quest.")</div>
                                </div>
                            }
                        }

                        @foreach (var roll in calls.Where(c => c.Name == "roll_dice"))
                        {
                            var view = roll.Ok == false ? null : ParseRoll(roll.Result);
                            <div class="dice-roll @(roll.Ok == false ? "fail" : "")" title="@Lang.T("Бросок мастера", "The master's roll")">
                                <span class="dice-roll-tag">@Lang.T("бросок", "roll")</span>
                                @if (view is null)
                                {
                                    <span class="dice-roll-plain">@CleanRoll(roll.Result)</span>
                                }
                                else
                                {
                                    <span class="dice-roll-body">
                                        @if (view.Reason.Length > 0)
                                        {
                                            <span class="dice-roll-why">@view.Reason</span>
                                        }
                                        <span class="dice-roll-math">
                                            @foreach (var part in view.Parts)
                                            {
                                                @if (part.Die is { } die)
                                                {
                                                    <span class="dr-term">
                                                        @if (part.Sign.Length > 0)
                                                        {
                                                            <span class="dr-op">@part.Sign</span>
                                                        }
                                                        <span class="dr-die">@die</span><span class="dr-face">[@Lang.T("Результат", "Result") <b>@part.Value</b>@(part.Note.Length > 0 ? $" ({part.Note})" : "")]</span>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="dr-term dr-bonus"><span class="dr-op">@(part.Sign.Length > 0 ? part.Sign : "+")</span> @(part.Sign == "−" ? Lang.T("Штраф", "Penalty") : Lang.T("Бонус", "Bonus")) <b>@part.Value</b></span>
                                                }
                                            }
                                            <span class="dr-term dr-total"><span class="dr-op">=</span> <b>@view.Total</b></span>
                                        </span>
                                    </span>
                                }
                            </div>
                        }

                        @if (bookCalls.Count > 0)
                        {
                            var failed = bookCalls.Count(c => c.Ok == false);
                            var running = bookCalls.Any(c => c.Ok is null);
                            <details class="tc-group @(failed > 0 ? "has-fail" : "") @(running ? "is-running" : "")">
                                <summary>
                                    <span class="tc-sum-title">@Lang.T("Записи мастера", "The master's records")</span>
                                    <span class="tc-sum-count">@bookCalls.Count</span>
                                    @if (failed > 0)
                                    {
                                        <span class="tc-sum-fail">@Lang.T("ошибок:", "errors:") @failed</span>
                                    }
                                    <span class="tc-sum-list">@string.Join(" · ", bookCalls.Take(4).Select(c => ToolLabel(c).Text))@(bookCalls.Count > 4 ? " …" : "")</span>
                                </summary>
                                <ul class="tc-list">
                                    @foreach (var call in bookCalls)
                                    {
                                        var (ico, text) = ToolLabel(call);
                                        <li class="@(call.Ok switch { true => "ok", false => "fail", _ => "run" })" title="@call.Name @call.Arguments">
                                            <span class="tc-ico">@ico</span>
                                            <span class="tc-text">@text</span>
                                            <span class="tc-status">@(call.Ok switch { true => "✓", false => "✗", _ => "…" })</span>
                                            @if (call.Ok == false && !string.IsNullOrWhiteSpace(call.Result))
                                            {
                                                <div class="tc-result">@TruncateResult(call.Result!)</div>
                                            }
                                        </li>
                                    }
                                </ul>
                            </details>
                        }

                        @foreach (var shopCall in calls.Where(c => c.Name == "open_trade" && c.Ok == true))
                        {
                            var ta = Args(shopCall);
                            var npcName = S(ta, "npc") ?? "";
                            var greeting = S(ta, "greeting")?.Trim().Trim('«', '»', '"', '“', '”', '„').Trim();
                            <div class="trade-card">
                                <div class="trade-card-body">
                                    <div class="trade-card-kicker">@Genre.PickT("Лавка", "Лавка", "Магазин", "Shop", "Shop", "Store")</div>
                                    <div class="trade-card-title">@npcName</div>
                                    @if (!string.IsNullOrWhiteSpace(greeting))
                                    {
                                        <div class="trade-card-greet">«@greeting»</div>
                                    }
                                </div>
                                <button class="btn-accent-ghost" @onclick="() => OpenTrade(npcName)">@Lang.T("Открыть лавку", "Open the shop")</button>
                            </div>
                        }

                        @foreach (var offer in calls.Where(c => c.Name == "offer_choices" && c.Ok == true))
                        {
                            var (question, options) = ParseChoices(offer);
                            @if (isActive && options.Count > 0)
                            {
                                <div class="choices is-active">
                                    @if (!string.IsNullOrWhiteSpace(question))
                                    {
                                        <div class="choices-q">@question</div>
                                    }
                                    <ol class="choice-list">
                                        @for (var n = 0; n < options.Count; n++)
                                        {
                                            var picked = options[n];
                                            <li style="--i:@n">
                                                <button class="choice" @onclick="() => SendTextAsync(picked, clearDraft: false, ooc: false)">
                                                    <span class="choice-n">@(n + 1)</span>
                                                    <span class="choice-text">@picked</span>
                                                </button>
                                            </li>
                                        }
                                    </ol>
                                    <div class="choices-hint">@Lang.T($"клавиши 1–{options.Count} · или опишите своё действие ниже", $"keys 1–{options.Count} · or describe your own action below")</div>
                                </div>
                            }
                        }

                        @foreach (var roleCall in calls.Where(c => c.Name == "ask_companion_role" && c.Ok == true))
                        {
                            var ra = Args(roleCall);
                            var recruit = (S(ra, "name") ?? Lang.T("спутник", "the companion")).Trim();
                            var concept = S(ra, "concept");
                            <div class="arcs roles @(isActive ? "" : "arcs-past")">
                                <div class="arcs-title">@Lang.T($"Какую роль займёт {recruit}?", $"What role will {recruit} take?")</div>
                                @if (!string.IsNullOrWhiteSpace(concept))
                                {
                                    <div class="roles-concept">@concept</div>
                                }
                                <div class="arcs-grid roles-grid">
                                    @for (var n = 0; n < Progression.Archetypes.Length; n++)
                                    {
                                        var role = Progression.Archetypes[n];
                                        <div class="arc-card role-card" style="--i:@n">
                                            <div class="role-emoji" aria-hidden="true">@role.Emoji</div>
                                            <div class="arc-name">@role.Ask</div>
                                            <div class="arc-tone">@role.Title</div>
