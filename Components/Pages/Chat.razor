    private enum DiceKind { Coin, D4, D6, D8, D10, D12, D20, D100 }

    private DiceKind _diceKind;
    private bool _rolling;
    private bool _diceSettled;
    private string _diceFace = "";
    private string _diceDisplay = "";

    /// <summary>Броски, ожидающие отправки: лежат чипами в поле ввода и уходят одним сообщением.</summary>
    private readonly List<(DiceKind Kind, string Face)> _pendingDice = new();

    /// <summary>Чат, которому принадлежат чипы: при переходе в другой черновик бросков сбрасывается.</summary>
    private string? _diceChatId;

    private bool IsRollLocked => _busy || _rolling;

    private static string DiceName(DiceKind kind) => kind == DiceKind.Coin ? Lang.T("Монета", "Coin") : "d" + DiceSides(kind);

    /// <summary>Название броска для чипа и для строки сообщения: «Кубик d20» или «Монета».</summary>
    private static string RollTitle(DiceKind kind) => kind == DiceKind.Coin ? Lang.T("Монета", "Coin") : Lang.T("Кубик ", "Die ") + DiceName(kind);

    private string DiceLabel => RollTitle(_diceKind);

    /// <summary>Убрать один бросок из черновика (крестик на чипе).</summary>
    private void RemoveRoll(int index)
    {
        if (index >= 0 && index < _pendingDice.Count)
        {
            _pendingDice.RemoveAt(index);
        }
    }

    private string DiceShapeClass => _diceKind switch
    {
        DiceKind.D4 => "shape-d4",
        DiceKind.D6 => "shape-d6",
        DiceKind.D8 => "shape-d8",
        DiceKind.D10 or DiceKind.D100 => "shape-d10",
        DiceKind.D12 => "shape-d12",
        _ => "shape-d20",
    };

    private static int DiceSides(DiceKind kind) => kind switch
    {
        DiceKind.D4 => 4,
        DiceKind.D6 => 6,
        DiceKind.D8 => 8,
        DiceKind.D10 => 10,
        DiceKind.D12 => 12,
        DiceKind.D20 => 20,
        DiceKind.D100 => 100,
        _ => 0,
    };

    private static string CoinFace => Random.Shared.Next(2) == 0 ? Lang.T("Орёл", "Heads") : Lang.T("Решка", "Tails");

    private async Task RollAsync(DiceKind kind)
    {
        if (_busy || _rolling)
        {
            return;
        }

        var sides = DiceSides(kind);
        _diceKind = kind;
        _rolling = true;
        _diceSettled = false;
        _diceFace = kind == DiceKind.Coin ? CoinFace : Random.Shared.Next(1, sides + 1).ToString();
        _diceDisplay = kind == DiceKind.Coin ? CoinFace : Random.Shared.Next(1, sides + 1).ToString();
        StateHasChanged();

        // Фаза броска: цифры мелькают, фигура кувыркается (CSS-анимация).
        for (var i = 0; i < 11; i++)
        {
            await Task.Delay(85);
            _diceDisplay = kind == DiceKind.Coin ? CoinFace : Random.Shared.Next(1, sides + 1).ToString();
            StateHasChanged();
        }

        // Фиксация результата: фигура «приземляется» с отскоком и свечением.
        _diceDisplay = _diceFace;
        _diceSettled = true;
        StateHasChanged();
        await Task.Delay(1150);

        _rolling = false;
        StateHasChanged();

        // Результат не уходит в чат сам: он ложится чипом в поле ввода, чтобы к нему
        // можно было дописать текст и насобрать несколько кубиков в одно сообщение.
        _pendingDice.Add((kind, _diceFace));
        StateHasChanged();
        try
        {
            await _inputRef.FocusAsync();
        }
        catch
        {
            // пререндер или разрыв соединения — фокус в поле ввода здесь не обязателен
        }
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("harness.scrollBottom", _logRef);
        }
        catch
        {
            // игнорируем: недоступно во время prerender/разрыва соединения
        }
    }

