    private static string MenuIconStyle(int index) => $"background-image:url('/sprites/{Genre.Pick("hero-book-menu.png", "cyber-book-menu.png", "modern-book-menu.png")}');background-size:300% 300%;{(Genre.IsFantasy ? "" : "image-rendering:pixelated;")}background-position:{index%3*50}% {index/3*50}%";
    private RenderFragment MenuButton(string key,string title,int icon,string count)=>b=>
    {
        b.OpenElement(0,"button");b.AddAttribute(1,"class","rp-menu-btn");b.AddAttribute(2,"onclick",EventCallback.Factory.Create(this,()=>OpenModal(key)));
        b.OpenElement(3,"span");b.AddAttribute(4,"class","rp-menu-icon");b.AddAttribute(5,"style",MenuIconStyle(icon));b.CloseElement();
        b.OpenElement(6,"span");b.AddContent(7,title);b.CloseElement();b.OpenElement(8,"small");b.AddContent(9,count);b.CloseElement();b.CloseElement();
    };
    private static string PartyItemStyle(GridItem item)=>$"left:{item.Col*30}px;top:{item.Row*30}px;width:{item.W*30}px;height:{item.H*30}px";
    private IEnumerable<CompanionCandidate> OpenCandidates => _state.CompanionCandidates.Where(c => c.Stage is "introduced" or "proven" or "ready");
    private string PartyMenuCount => OpenCandidates.Count() is var count && count > 0 ? $"{_state.Party.Count}/3 · +{count}" : $"{_state.Party.Count}/3";
    private static string CandidateStageTitle(CompanionCandidate c) => c.Stage switch { "ready" => Lang.T("готов поговорить", "ready to talk"), "proven" => Lang.T("доверие растёт", "trust is growing"), _ => Lang.T("новое знакомство", "new acquaintance") };
    private void AskLeave(PartyMember member){_leaveMember=member.Name;_leaveReason="";}
    private void CancelLeave(){_leaveMember=null;_leaveReason="";}
    private void SubmitLeave()
    {
        if(ChatId is null||_leaveMember is null||string.IsNullOrWhiteSpace(_leaveReason))return;
        PartyFlow.RequestLeave(ChatId,_leaveMember,_leaveReason.Trim());CancelLeave();CloseModal();
    }

    private GridItem? ActionItem => _itemAction == "request"
        ? _state.Party.FirstOrDefault(p=>p.Name==_itemMember)?.Grid.FirstOrDefault(i=>i.Id==_itemActionId)
        : _state.Grid.FirstOrDefault(i=>i.Id==_itemActionId);
    private bool IsConsumable(GridItem item) => item.Consumable || Catalog.Get(item.Icon)?.Cat is "potion" or "food" or "scroll" or "book";
    private void SelectPartyItem(GridItem item){_partyItemId=_partyItemId==item.Id?null:item.Id;_partyMsg="";}
    private void StartItemAction(string action,GridItem item){_itemAction=action;_itemActionId=item.Id;_itemMember="";_itemActionQty=1;}
    private void StartPartyRequest(PartyMember member,GridItem item){_itemAction="request";_itemActionId=item.Id;_itemMember=member.Name;_itemActionQty=1;}
    private void CancelItemAction(){_itemAction=null;_itemActionId="";_itemMember="";_itemActionQty=1;}
    private bool HasRoom(List<GridItem> bag,GridItem item)=>bag.Any(i=>InventoryOps.CanStack(i,item))||InventoryOps.FindFree(bag,item.W,item.H) is not null;
    private bool CanReceive(PartyMember member,GridItem item)=>HasRoom(member.Grid,item);
    private bool CanHeroReceive(GridItem item)=>HasRoom(_state.Grid,item);
    private string ItemActionTitle(GridItem item)=>_itemAction switch{"give"=>Lang.T($"Отдать «{item.Name}»", $"Give \"{item.Name}\""),"request"=>Lang.T($"Попросить «{item.Name}»", $"Ask for \"{item.Name}\""),_=>Lang.T($"Использовать «{item.Name}»", $"Use \"{item.Name}\"")};
    private string ItemActionHint=>_itemAction switch{"give"=>Lang.T("Выберите спутника. Он самостоятельно решит, согласен ли принять предмет.", "Choose a companion. They decide on their own whether to accept the item."),"request"=>Lang.T("ГМ отыграет просьбу и решение спутника. Предмет перейдёт только после его согласия.", "The GM plays out the request and the companion's decision. The item passes only after their consent."),_=>Lang.T("Выберите цель. ГМ применит эффект расходника и только затем спишет одну единицу.", "Choose a target. The GM applies the consumable's effect and only then deducts one unit.")};
    private void SubmitItemAction(string member,string target)
    {
        if(ChatId is null||ActionItem is not { } item)return;
        var qty=_itemAction=="use"?1:Math.Clamp(_itemActionQty,1,Math.Max(1,item.Quantity));
        if(_itemAction=="give"&&_state.Party.FirstOrDefault(p=>p.Name==member) is { } receiver&&!CanReceive(receiver,item)){Report(false,Lang.T($"У {member} нет места для «{item.Name}».", $"{member} has no room for \"{item.Name}\"."));return;}
        if(_itemAction=="request"&&!CanHeroReceive(item)){_partyMsg=Lang.T($"В сумке героя нет места для «{item.Name}» ({item.W}×{item.H}).", $"No room in the hero's bag for \"{item.Name}\" ({item.W}×{item.H}).");CancelItemAction();return;}
        PartyFlow.RequestItemAction(new PartyItemRequest(ChatId,_itemAction!,member,item.Id,item.Name,qty,target));
        CancelItemAction();CloseModal();
    }

    private bool _openCharacter = true;
    private bool _openInventory = true;
    private bool _openParty = true;
    private bool _openNpcs = true;
    private bool _openCities = true;
    private bool _openQuests = true;
    private bool _openArc = true;
    private bool _openWorld = true;

    /// <summary>Шаг сетки в пикселях (совпадает с --cell в RpgPanel.razor.css).</summary>
    private const int CellPx = 34;

    /// <summary>Слоты куклы: (слот, подпись, иконка-подсказка для пустого слота). Расположение задаёт CSS (grid-area).</summary>
    private static (EquipSlot Slot, string Label, string Ghost)[] _equipLayout => new[]
    {
        (EquipSlot.Hand1, Lang.T("Оружие", "Weapon"), "sword"),
        (EquipSlot.Cloak, Lang.T("Плащ", "Cloak"), "cloak"),
        (EquipSlot.Helmet, Lang.T("Шлем", "Helmet"), "helmet"),
        (EquipSlot.Amulet, Lang.T("Амулет", "Amulet"), "amulet"),
        (EquipSlot.Hand2, Lang.T("Щит / 2-я рука", "Shield / off hand"), "shield"),
        (EquipSlot.Gloves, Lang.T("Перчатки", "Gloves"), "gloves"),
        (EquipSlot.Body, Lang.T("Доспех", "Armor"), "body"),
        (EquipSlot.Ring1, Lang.T("Кольцо", "Ring"), "ring"),
        (EquipSlot.Ring2, Lang.T("Кольцо", "Ring"), "ring2"),
        (EquipSlot.Boots, Lang.T("Сапоги", "Boots"), "boots"),
        (EquipSlot.Belt, Lang.T("Пояс", "Belt"), "belt"),
    };

    private RpgState _state = new();
    private string? _subscribedId;

    // ===== Счётчик контекста (рядом с оглавлением книги героя) =====

    private ContextUsage? _ctx;
    private DateTime _ctxAt;
    private int _toolsChars = -1;

    /// <summary>
    /// Заполнение контекстного окна. Пересчитывается не чаще раза в секунду: RpgStore шлёт StateChanged
    /// на каждое нажатие клавиши в полях книги, а сборка сводки читает Journal.md с диска.
    /// </summary>
    private ContextUsage? Context
    {
        get
        {
            if (_ctx is not null && DateTime.UtcNow - _ctxAt < TimeSpan.FromSeconds(1))
            {
                return _ctx;
            }

            _ctxAt = DateTime.UtcNow;
            _ctx = ComputeContext();
            return _ctx;
        }
    }

    /// <summary>
    /// Считает заполнение так же, как это делает отправка запроса в Chat.razor: тот же системный промпт,
    /// та же сводка книги героя, те же описания инструментов и та же укладка истории в лимит.
    /// </summary>
    private ContextUsage? ComputeContext()
    {
        if (string.IsNullOrWhiteSpace(ChatId))
        {
            return null;
        }

        var session = Store.Get(ChatId);
        if (session is null)
        {
            return null;
        }

        var settings = SettingsSvc.Current;

        // Активный инстанс ведёт свою историю — считаем её, а не основной чат.
        var source = _state.ActiveInstance is { Active: true } instance
            ? instance.Messages.ToList()
            : session.Messages.Where(m => string.IsNullOrEmpty(m.InstanceId)).ToList();

        var history = LlmClient.TrimHistory(source, settings.HistoryLimit, out _);
        _toolsChars = _toolsChars >= 0 ? _toolsChars : Tools.DefinitionsChars;
        var stateNote = Tools.BuildStateNote(ChatId, RpgStore.ReadJournalTail(ChatId, 2500));
        return LlmClient.MeasureContext(settings, LlmClient.ReservedChars(settings, stateNote, _toolsChars), history);
    }

    /// <summary>Компактная запись числа: 98 400 → «98k», 128 000 → «128k», 950 → «950».</summary>
    private static string Short(long tokens) => tokens >= 1000 ? $"{tokens / 1000}k" : tokens.ToString();

    private static string CtxClass(ContextUsage ctx) => ctx.Percent >= 100
        ? "is-full"
        : ctx.OverCompress ? "is-warn" : "is-ok";

    private static string CtxTitle(ContextUsage ctx)
    {
        var compress = ctx.CompressPercent >= 100
            ? Lang.T("автосокращение истории выключено", "history auto-compression is off")
            : Lang.T($"при {ctx.CompressPercent}% история начнёт сокращаться", $"at {ctx.CompressPercent}% the history starts to be compressed");
        return Lang.T($"Занято {ctx.UsedTokens:N0} токенов из {ctx.LimitTokens:N0} — {ctx.Percent}%. " +
               $"Учитываются системный промпт, сводка книги героя, описания инструментов и история чата; {compress}.",
               $"{ctx.UsedTokens:N0} of {ctx.LimitTokens:N0} tokens used — {ctx.Percent}%. " +
               $"The system prompt, the hero book summary, tool descriptions and the chat history are counted; {compress}.");
    }

    // Перетаскивание: предмет сумки или надетый предмет + клетка, за которую его взяли.
    private string? _dragId;
    private EquipSlot? _dragSlot;
    private int _grabCol;
    private int _grabRow;

    // Выбранный предмет (карточка под сумкой).
    private string? _selId;
    private EquipSlot? _selSlot;

    private string _newGridName = "";
    private string? _invMsg;
    private bool _invMsgOk;

    protected override void OnInitialized()
    {
        RpgStore.StateChanged += OnStateChanged;
        // История чата растёт без изменений книги героя — счётчику контекста нужно и это событие.
        Store.Changed += OnChatChanged;
    }

    protected override void OnParametersSet()
    {
        _state = RpgStore.GetOrCreate(ChatId);
        if (_subscribedId != ChatId)
        {
            _subscribedId = ChatId;
            ClearSelection();
            _invMsg = null;
            _floats.Clear();
            _flash.Clear();
        }

        DiffVitals();
    }

    /// <summary>Мастер (или другая вкладка) изменил состояние — перерисовываемся.</summary>
    private void OnStateChanged(string sessionId)
    {
        if (sessionId != ChatId)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            _state = RpgStore.GetOrCreate(ChatId);
            DiffVitals();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        RpgStore.StateChanged -= OnStateChanged;
        Store.Changed -= OnChatChanged;
        _disposed = true;
    }

    /// <summary>Чат изменился (новое сообщение, ответ мастера) — обновляем счётчик контекста.</summary>
    private void OnChatChanged() => _ = InvokeAsync(StateHasChanged);

    // ===== Всплывающие изменения: −3 HP, +12 золота… =====

    private sealed record FloatNote(int Id, string Stat, string Text, bool Up);

    private readonly List<FloatNote> _floats = new();
    private readonly HashSet<string> _flash = new();
    private Dictionary<string, int>? _vitals;
    private string? _vitalsChat;
    private int _floatSeq;
    private bool _disposed;

    private Dictionary<string, int> CurrentVitals() => new()
    {
        ["hp"] = _state.Character.HpCurrent,
        ["mana"] = _state.Character.ManaCurrent,
        ["gold"] = _state.Character.Gold,
        ["xp"] = _state.Character.Xp,
        ["level"] = int.TryParse(LevelText, out var lv) ? lv : 0,
    };

    /// <summary>Сравнивает показатели с прошлыми и запускает всплывающие цифры.</summary>
    private void DiffVitals()
    {
        var now = CurrentVitals();
        if (_vitals is null || _vitalsChat != ChatId)
        {
            _vitals = now;
            _vitalsChat = ChatId;
            return;
        }

        foreach (var (stat, value) in now)
        {
            var delta = value - _vitals[stat];
            if (delta == 0)
            {
                continue;
            }

            var note = new FloatNote(++_floatSeq, stat, (delta > 0 ? "+" : "−") + Math.Abs(delta), delta > 0);
            _floats.Add(note);
            if (stat == "hp" && delta < 0)
            {
                _flash.Add("hp");
            }

            _ = ExpireAsync(note);
        }

        _vitals = now;
    }

    private async Task ExpireAsync(FloatNote note)
    {
        await Task.Delay(1800);
        if (_disposed)
        {
            return;
        }

        await InvokeAsync(() =>
        {
            _floats.Remove(note);
            if (!_floats.Any(f => f.Stat == "hp" && !f.Up))
            {
                _flash.Remove("hp");
            }

            StateHasChanged();
        });
    }

    private string FlashClass(string stat) => _flash.Contains(stat) ? "is-hit" : "";

    private RenderFragment Floats(string stat) => builder =>
    {
        foreach (var f in _floats.Where(f => f.Stat == stat))
        {
            builder.OpenElement(0, "span");
            builder.SetKey(f.Id);
            builder.AddAttribute(1, "class", $"rp-float {(f.Up ? "up" : "down")}");
            builder.AddAttribute(2, "aria-hidden", "true");
            builder.AddContent(3, f.Text);
            builder.CloseElement();
        }
    };

    private void Save() => RpgStore.Save(ChatId, _state);

    private void OpenShop(string npcName)
    {
        if (ChatId is not null)
        {
            Trade.Open(ChatId, npcName);
        }
    }

    /// <summary>«Начать разговор»: ход в чат, где ГМ сам придумает встречу (слухи, квест или разовую сделку).</summary>
    private void TalkTo(string npcName)
    {
        if (ChatId is not null)
        {
            Talk.Request(ChatId, npcName);
        }
    }

    /// <summary>Имя героя или заглушка (задаётся при создании чата).</summary>
    private string HeroName =>
        string.IsNullOrWhiteSpace(_state.Character.Name) ? Lang.T("Безымянный герой", "Nameless hero") : _state.Character.Name.Trim();

    /// <summary>Уровень (меняет только мастер игры).</summary>
    private string LevelText =>
        string.IsNullOrWhiteSpace(_state.Character.Level) ? "1" : _state.Character.Level.Trim();

    /// <summary>Портрет героя из общего листа <c>hero-avatars.png</c> (см. <see cref="HeroAvatars"/>).</summary>
    private string AvatarStyle =>
        HeroAvatars.Style(_state.Character.Avatar, _state.Character.CharClass, _state.Character.Gender);

    /// <summary>Значение или подпись-заглушка (для read-only полей).</summary>
    private static string? TagOr(string? value, string? alt)
    {
        var v = (value ?? "").Trim();
        if (v.Length > 0)
        {
            return v;
        }

        return string.IsNullOrEmpty(alt) ? "" : alt;
    }

    private static string NoteSuffix(string? note) => string.IsNullOrWhiteSpace(note) ? "" : " — " + note;

    private static string Signed(int v) => v >= 0 ? $"+{v}" : $"−{-v}";

    private static string StatSuffix(string stats) => stats.Length == 0 ? "" : " · " + stats;

    /// <summary>Характеристики предмета в карточке: урон, броня, бонусы, особые свойства и бюджет редкости.</summary>
    private static RenderFragment StatBlock(string damage, int armor, Dictionary<string, int> bonuses, List<string> effects, string rarity) => __builder =>
    {
        var spent = ItemStats.Spent(bonuses);
        var budget = ItemStats.Budget(rarity);
        var key = ItemEconomy.RarityKey(rarity);
        <div class="rp-ic-stats rar-@key">
            <div class="rp-ic-rarity">
                <span>@ItemEconomy.RarityTitle(rarity)</span>
                @if (budget > 0)
                {
                    <small title="@(Lang.T("Очки бонусов по редкости: +1 к характеристике/атаке/урону = 1, +1 КБ = 2, +5 HP/", "Bonus points by rarity: +1 to an ability/attack/damage = 1, +1 AC = 2, +5 HP/") + Genre.ManaGen + " = 1")">@Lang.T("бонусы", "bonuses") @spent/@budget</small>
                }
            </div>
            @if (damage.Length > 0 || armor > 0)
            {
                <div class="rp-ic-base">
                    @if (damage.Length > 0)
                    {
                        <span><small>@Lang.T("урон", "damage")</small> @damage</span>
                    }
                    @if (armor > 0)
                    {
                        <span><small>@Lang.T("броня", "armor")</small> @Lang.T("КБ", "AC") +@armor</span>
                    }
                </div>
            }
            @if (bonuses.Count > 0)
            {
                <div class="rp-ic-bonuses">
                    @foreach (var k in ItemStats.Keys.Where(bonuses.ContainsKey))
                    {
                        var v = bonuses[k];
                        <span class="rp-ic-bonus @(v < 0 ? "neg" : "")">@ItemStats.KeyTitle(k) @Signed(v)</span>
                    }
                </div>
            }
            @foreach (var e in effects)
            {
                <div class="rp-ic-effect">✦ @e</div>
            }
            @if (damage.Length == 0 && armor == 0 && bonuses.Count == 0 && effects.Count == 0)
            {
                <div class="rp-ic-none">@Lang.T("Без особых характеристик", "No special stats")</div>
            }
        </div>
    };


    private int UsedCells => _state.Grid.Sum(i => i.W * i.H);

    // ===== Иконки =====

    /// <summary>Пропорции области слота куклы (в условных клетках) — чтобы выбрать поворот иконки.</summary>
    private static (int W, int H) SlotShape(EquipSlot slot) => slot switch
    {
        EquipSlot.Hand1 or EquipSlot.Hand2 => (2, 4),
        EquipSlot.Cloak or EquipSlot.Gloves or EquipSlot.Body => (2, 3),
        _ => (1, 1),
    };

    /// <summary>
    /// Спрайты оружия нарисованы по диагонали; в вытянутой вверх области их поворачиваем на −45°,
    /// чтобы клинок встал вертикально и занял всю высоту — как в Diablo.
    /// </summary>
    private string IconClass(string icon, (int W, int H) box)
    {
        var def = Catalog.Get(icon);
        return def is { Diag: true } && box.H > box.W ? "diag" : "fit";
    }

    private string ItemMeta(string icon, int w, int h, EquipSlot? slot, bool twoHanded)
    {
        var def = Catalog.Get(icon);
        var home = slot ?? def?.EquipSlot;
        var parts = new List<string> { $"{w}×{h}" };
        if (home is { } s)
        {
            parts.Add(twoHanded ? Lang.T("двуручное", "two-handed") : InventoryOps.SlotTitle(s));
        }

        if (def is not null)
        {
            parts.Add(def.Name.ToLowerInvariant());
        }

        return string.Join(" · ", parts);
    }

    // ===== Выбор =====

    private GridItem? SelectedItem => _selId is null ? null : _state.Grid.FirstOrDefault(i => i.Id == _selId);

    private EquippedItem? SelectedWorn =>
        _selSlot is { } s ? _state.Character.Equipment.GetValueOrDefault(s.ToString()) : null;

    private bool IsSelectedSlot(EquipSlot slot) =>
        _selSlot is { } s && SelectedWorn is { } w &&
        (s == slot || (w.TwoHanded && slot is EquipSlot.Hand1 or EquipSlot.Hand2));

    private void SelectItem(GridItem item)
    {
        _selSlot = null;
        _selId = _selId == item.Id ? null : item.Id;
    }

    private void SelectSlot(EquipSlot slot)
    {
        if (!_state.Character.Equipment.ContainsKey(slot.ToString()))
        {
            return;
        }

        _selId = null;
        _selSlot = _selSlot == slot ? null : slot;
    }

    private void ClearSelection()
    {
        _selId = null;
        _selSlot = null;
    }

    private void Report(bool ok, string message)
    {
        _invMsgOk = ok;
        _invMsg = message;
    }

    // ===== Экипировка =====

    private bool CanDropOn(EquipSlot slot)
    {
        if (_dragId is null)
        {
            return false;
        }

        var item = _state.Grid.FirstOrDefault(i => i.Id == _dragId);
        return item is not null &&
               InventoryOps.CanGoTo(item.Slot ?? Catalog.Get(item.Icon)?.EquipSlot, item.TwoHanded, slot);
    }

    private void QuickEquip(GridItem item)
    {
        var ok = InventoryOps.Equip(_state, item, null, Catalog, out var msg);
        Report(ok, msg);
        if (ok)
        {
            ClearSelection();
            Save();
        }
    }

    private void UnequipSlot(EquipSlot slot, bool drop)
    {
        var ok = InventoryOps.Unequip(_state, slot, Catalog, drop, out var msg);
        Report(ok, msg);
        if (ok)
        {
            ClearSelection();
            Save();
        }
    }

    private void DropItem(GridItem item)
    {
        _state.Grid.Remove(item);
        Report(true, Lang.T($"«{item.Name}» выброшен.", $"\"{item.Name}\" discarded."));
        ClearSelection();
        Save();
    }

    // ===== Перетаскивание =====

    private string GridItemStyle(GridItem item) =>
        $"left:calc({item.Col} * var(--cell) + 2px); top:calc({item.Row} * var(--cell) + 2px);" +
        $"width:calc({item.W} * var(--cell) - 2px); height:calc({item.H} * var(--cell) - 2px);";

    private static string GridItemTitle(GridItem item) =>
        item.Name + (item.Quantity > 1 ? $" x{item.Quantity}" : "") + $" ({item.W}×{item.H})" + StatSuffix(ItemStats.Describe(item)) + NoteSuffix(item.Note);

    private void GridDragStart(DragEventArgs e, GridItem item)
    {
        _dragId = item.Id;
        _dragSlot = null;
        // Клетка внутри предмета, за которую его взяли: при сбросе она окажется под курсором.
        _grabCol = Math.Clamp((int)(e.OffsetX / CellPx), 0, item.W - 1);
        _grabRow = Math.Clamp((int)(e.OffsetY / CellPx), 0, item.H - 1);
    }

    private void SlotDragStart(EquipSlot slot)
    {
        if (!_state.Character.Equipment.ContainsKey(slot.ToString()))
        {
            return;
        }

        _dragSlot = slot;
        _dragId = null;
        _grabCol = 0;
        _grabRow = 0;
    }

    private void DragEnd()
    {
        _dragId = null;
        _dragSlot = null;
    }

    private void SlotDrop(EquipSlot slot)
    {
        var id = _dragId;
        DragEnd();
        if (id is null)
        {
            return;
        }

        var item = _state.Grid.FirstOrDefault(i => i.Id == id);
        if (item is null)
        {
            return;
        }

        var ok = InventoryOps.Equip(_state, item, slot, Catalog, out var msg);
        Report(ok, msg);
        if (ok)
        {
            ClearSelection();
            Save();
        }
    }

    private void CellDrop(int col, int row)
    {
        var id = _dragId;
        var fromSlot = _dragSlot;
        var grabCol = _grabCol;
        var grabRow = _grabRow;
        DragEnd();

        if (fromSlot is { } slot)
        {
            // Снятие перетаскиванием: кладём в сумку, затем пробуем поставить в выбранную клетку.
            var before = _state.Grid.ToList();
            if (!InventoryOps.Unequip(_state, slot, Catalog, false, out var msg))
            {
                Report(false, msg);
                return;
            }

            var added = _state.Grid.FirstOrDefault(i => !before.Contains(i));
            if (added is not null)
            {
                var c = Math.Clamp(col, 0, RpgState.GridCols - added.W);
                var r = Math.Clamp(row, 0, RpgState.GridRows - added.H);
                if (InventoryOps.Fits(_state.Grid, c, r, added.W, added.H, added))
                {
                    (added.Col, added.Row) = (c, r);
                }
            }

            Report(true, msg);
            ClearSelection();
            Save();
            return;
        }

        var item = id is null ? null : _state.Grid.FirstOrDefault(i => i.Id == id);
        if (item is null)
        {
            return;
        }

        var col0 = Math.Clamp(col - grabCol, 0, RpgState.GridCols - item.W);
        var row0 = Math.Clamp(row - grabRow, 0, RpgState.GridRows - item.H);
        if (InventoryOps.Fits(_state.Grid, col0, row0, item.W, item.H, item))
        {
            item.Col = col0;
            item.Row = row0;
            Save();
        }
    }

    // ===== Добавление вручную =====

    private void GridNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddGridItem();
        }
    }

    private void AddGridItem()
    {
        var name = _newGridName.Trim();
        if (name.Length == 0)
        {
            return;
        }

        var def = Catalog.Guess(name);
        var w = def?.W ?? 1;
        var h = def?.H ?? 1;
        var spot = InventoryOps.FindFree(_state.Grid, w, h);
        if (spot is null)
        {
            Report(false, Lang.T($"В сумке нет места {w}×{h} для «{name}».", $"No {w}×{h} room in the bag for \"{name}\"."));
            return;
        }

        var item = new GridItem
        {
            Name = name,
            Icon = def?.Id ?? "sack",
            Col = spot.Value.Col,
            Row = spot.Value.Row,
            W = w,
            H = h,
            Slot = def?.EquipSlot,
            TwoHanded = def?.TwoHanded ?? false,
        };
        _state.Grid.Add(item);
        _newGridName = "";
        _selSlot = null;
        _selId = item.Id;
        Report(true, Lang.T($"Добавлено: «{name}» ({w}×{h}).", $"Added: \"{name}\" ({w}×{h})."));
        Save();
    }

    // ===== Персонаж =====

    private void NudgeHp(int delta)
    {
        _state.Character.HpCurrent = Math.Clamp(_state.Character.HpCurrent + delta, 0, Math.Max(_state.Character.HpMax, _state.Character.HpCurrent));
        Save();
    }

    private void NudgeMana(int delta)
    {
        _state.Character.ManaCurrent = Math.Clamp(_state.Character.ManaCurrent + delta, 0, Math.Max(_state.Character.ManaMax, _state.Character.ManaCurrent));
        Save();
    }

    private void AddMana()
    {
        _state.Character.ManaMax = Math.Max(_state.Character.ManaMax, 10);
        _state.Character.ManaCurrent = Math.Max(_state.Character.ManaCurrent, _state.Character.ManaMax);
        Save();
    }

    private void RemoveStatus(string status)
    {
        _state.Character.Status.Remove(status);
        Save();
    }

