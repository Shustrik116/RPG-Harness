/// <summary>Реплики чата в хронологическом порядке (старые сверху, новые снизу — как в обычном чате).</summary>
IEnumerable<ChatMessage> History
{
 get
 {
  if(_chatId is null)return Array.Empty<ChatMessage>();
  return Store.Get(_chatId)?.Messages
   .Where(m=>!m.Hidden&&m.Content.Trim().Length>0) ?? Array.Empty<ChatMessage>();
 }
}

 static string Short(string text)
 {
  var t=text.Trim();
  return t.Length<=600?t:t[..600]+"…";
 }

// ===== Ходы =====

/// <summary>Мастер сейчас ведёт ход (кнопка заблокирована, статус виден в шапке).</summary>
bool Busy=>_status.Length>0;

/// <summary>Герой не может действовать: 0 ХП («при смерти») или эффект, запрещающий ход.</summary>
bool HeroBlocked=>_state.Character.HpCurrent<=0||_state.Character.Status.Any(CombatEffects.SkipsTurn);

/// <summary>Очередь ещё не дошла до героя: вместо его действия просим мастера продолжить автоходы.</summary>
bool AwaitingHeroTurn=>_state.CombatRound>0&&!CombatRules.SameActor(_state,_state.CombatCurrentActor,_state.Character.Name);



void Turn()
{
 if(_chatId is null)return;
 // Свой ход — всегда показываем низ истории, даже если игрок до этого листал вверх.
 _scrollHistory=true;_forceScrollHistory=true;
 // Герой не может ходить: не выбираем действие, а просим мастера пропустить его ход и вести бой дальше.
 if(HeroBlocked||AwaitingHeroTurn)
 {
  var note = string.IsNullOrWhiteSpace(_custom) ? "" : Lang.T($" Замечание игрока: {_custom.Trim()}.", $" The player's note: {_custom.Trim()}.");
  Battle.Act(_chatId,Lang.T($"[ПРОДОЛЖЕНИЕ БОЯ] {(HeroBlocked?"Герой не может действовать (0 ХП, «при смерти» или эффект, запрещающий ход). Пропусти его ход.":$"Сейчас по combat_turn действует {_state.CombatCurrentActor}, а не герой.")} Веди бой дальше строго по combat_turn: после полного действия каждого участника вызывай advance. Когда текущим участником станет способный действовать герой — остановись перед его действием и передай слово игроку.{note}",
    $"[CONTINUE COMBAT] {(HeroBlocked?"The hero cannot act (0 HP, \"dying\" or an effect that forbids acting). Skip their turn.":$"By combat_turn, {_state.CombatCurrentActor} is acting now, not the hero.")} Keep running the fight strictly by combat_turn: after each participant's full action call advance. When the hero, able to act, becomes the current participant — stop before their action and give the floor to the player.{note}"));
  _custom="";
  return;
 }
 var target = _target.Length>0 ? _target : Lang.T("не выбрана (игрок не указал цель)", "not chosen (the player did not specify a target)");
 var action = _action.Length>0 ? _action : Lang.T("не выбрано (игрок не указал действие)", "not chosen (the player did not specify an action)");
 var custom = string.IsNullOrWhiteSpace(_custom) ? "—" : _custom.Trim();
 Battle.Act(_chatId,Lang.T($"[БОЕВОЙ ХОД] Цель: {target}. Действие: {action}. Дополнительная информация от игрока: {custom}. Оцени возможность хода, назначь и сделай честные броски, затем обнови состояние боя, учитывая и выбранные цель/действие, и любые уточнения игрока (нестандартное действие имеет приоритет над базовым). После полного действия каждого участника переводи очередь через combat_turn advance. Затем разыграй самостоятельные ходы спутников и противников строго до момента, когда текущим участником снова станет герой; остановись перед его следующим действием.",
    $"[COMBAT TURN] Target: {target}. Action: {action}. Extra details from the player: {custom}. Evaluate whether the move is possible, make fair rolls, then update the combat state, taking into account both the chosen target/action and any clarifications from the player (a non-standard action takes priority over the basic one). After each participant's full action advance the queue via combat_turn advance. Then play out the independent turns of companions and adversaries strictly until the hero becomes the current participant again; stop before their next action."));
 _custom="";
}

 void Toggle(GridItem i){if(!_skipped.Add(i.Id))_skipped.Remove(i.Id);}
 /// <summary>Сколько предметов добычи отмечено к забору (по умолчанию — все, пока игрок не снимет отметку).</summary>
 int _picked=>_state.BattleLoot.Count(i=>!_skipped.Contains(i.Id));
 /// <summary>Строка под названием: редкость, слот и уровень предмета.</summary>
 string LootMeta(GridItem item)
 {
  var parts=new List<string>();
  var rarity=ItemEconomy.RarityTitle(item.Rarity);
  if(rarity.Length>0)parts.Add(char.ToUpperInvariant(rarity[0])+rarity[1..]);
  if(item.Slot is {} slot)parts.Add(InventoryOps.SlotTitle(slot)+(item.TwoHanded?Lang.T(", двуручное", ", two-handed"):""));
  if(item.Level>0)parts.Add($"{Lang.T("ур.", "lvl")} {item.Level}");
  if(item.Quantity>1)parts.Add($"{item.Quantity} {Lang.T("шт.", "pcs")}");
  return string.Join(" · ",parts);
 }
 /// <summary>Описание предмета: характеристики (урон, КБ, бонусы, умения) и заметка мастера.</summary>
 string LootDescription(GridItem item)
 {
  var stats=ItemStats.HasStats(item)?ItemStats.Describe(item):"";
  var note=(item.Note??"").Trim();
  return stats.Length>0&&note.Length>0?$"{stats} · {note}":stats.Length>0?stats:note;
 }
 void FinalizeLoot()
 {
  if(_chatId is null)return;
  var got=new List<string>();var left=new List<string>();
  foreach(var item in _state.BattleLoot.Where(i=>!_skipped.Contains(i.Id)).ToList())
  {
   var spot=InventoryOps.FindFree(_state.Grid,item.W,item.H);
   if(spot is null){left.Add(item.Name);continue;}
   item.Col=spot.Value.Col;item.Row=spot.Value.Row;_state.Grid.Add(item);_state.BattleLoot.Remove(item);got.Add(item.Name+(item.Quantity>1?$" ×{item.Quantity}":""));
  }
  // Пропущенное игроком остаётся лежать на месте боя; не поместившееся ждёт в окне добычи, пока герой не освободит место.
  _state.BattleLoot.RemoveAll(i=>_skipped.Contains(i.Id));_skipped.Clear();
  // Сдавшиеся остаются в истории — мастер решает их судьбу; поверженные и бежавшие уходят со сцены.
  var captives=_state.Adversaries.Where(a=>a.Morale=="surrendered"&&a.HpCurrent>0).Select(a=>a.Name).ToList();
  _state.Adversaries.Clear();
  var cleanup=CombatRules.EndCombat(_state);
  RpgStore.Save(_chatId,_state);_open=false;
  Battle.Act(_chatId,Lang.T($"[ФИНАЛ БОЯ] Обыск завершён. Забрано: {(got.Count>0?string.Join(", ",got):"ничего")}.", $"[END OF COMBAT] The search is done. Taken: {(got.Count>0?string.Join(", ",got):"nothing")}.")+
   (left.Count>0?Lang.T($" Не поместилось в сумку (ждёт в окне добычи, пока герой освободит место): {string.Join(", ",left)}.", $" Did not fit in the bag (waits in the loot window until the hero frees up space): {string.Join(", ",left)}."):"")+
   (captives.Count>0?Lang.T($" Сдались и ждут решения героя: {string.Join(", ",captives)}.", $" Surrendered and await the hero's decision: {string.Join(", ",captives)}."):"")+
   Lang.T($" {cleanup}Примени итог добычи, опиши, чем закончился бой, и заверши ход через offer_choices (2–4 варианта, что делать дальше).", $" {cleanup}Apply the loot outcome, describe how the fight ended and finish the turn with offer_choices (2–4 options for what to do next)."));
 }
