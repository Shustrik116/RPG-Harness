@implements IDisposable
@inject BattleFlow Battle
@inject BattleLog BattleLogSvc
@inject RpgStateStore RpgStore
@inject ChatStore Store
@inject ItemCatalog Catalog
@inject ItemEconomy Economy
@inject PartyFlow PartyFlow
@inject IJSRuntime JS

@if (_open)
{
 <div class="bw-backdrop" @onclick="Close"><div class="bw-wrap" @onclick:stopPropagation="true"><section class="bw-modal">
  <header>
   <div>
    <h2>⚔ @Lang.T("Бой", "Combat")</h2>
    <span>@(Victory ? Lang.T("Победа — можно обыскать противников", "Victory — the adversaries can be searched") : _state.CombatRound>0 ? Lang.T($"Раунд {_state.CombatRound} · ход: {_state.CombatCurrentActor}", $"Round {_state.CombatRound} · turn: {_state.CombatCurrentActor}") : Lang.T("Выберите цель и действие", "Choose a target and an action"))</span>
    <span class="bw-chat-status @(_status.Length>0?"busy":"idle")" title="@Lang.T("Состояние чата мастера", "The master's chat status")">
      <i></i>@(_status.Length>0?_status:Lang.T("Рассказчик готов", "The narrator is ready"))
    </span>
   </div>
   <button @onclick="Close">✕</button>
  </header>
  <div class="bw-arena">
   <div class="bw-side">
    <h3>@Genre.PickT("Группа", "Команда", "Команда", "Party", "Crew", "Team")</h3>
    @* ===== Герой ===== *@
    <div class="bw-actor bw-ally @ShakeClass(HeroTarget)">
     <span class="bw-ally-portrait" style="@HeroPortrait"></span>
     <div class="bw-ally-main">
      <b class="bw-name"><span class="bw-name-t" title="@HeroTitle(_state.Character.Name)">@HeroTitle(_state.Character.Name)</span>@SeatBadge(_state.Character.Name,true)</b>
      <div class="bw-bar">
       <span class="bw-bar-label">@Lang.T("Жизнь", "HP"): @_state.Character.HpCurrent/@_state.Character.HpMax@if(_state.Character.Shield>0){<text> · @Lang.T("щит", "shield") @_state.Character.Shield</text>}</span>
       <div class="bw-track"><i class="hp" style="@Css.Percent(_state.Character.HpCurrent,_state.Character.HpMax)"></i>@if(_state.Character.Shield>0){<em style="@Css.Percent(Math.Min(_state.Character.Shield,_state.Character.HpMax),_state.Character.HpMax)"></em>}</div>
      </div>
      @if(_state.Character.ManaMax>0){
       <div class="bw-bar">
        <span class="bw-bar-label">@Genre.PickT("Мана", "ОЗУ", "Концентрация", "Mana", "RAM", "Focus"): @_state.Character.ManaCurrent/@_state.Character.ManaMax</span>
        <div class="bw-track mana"><i style="@Css.Percent(_state.Character.ManaCurrent,_state.Character.ManaMax)"></i></div>
       </div>
      }
      @if(_state.Character.Status.Count>0){<small class="bw-effects-list">@string.Join(" · ",_state.Character.Status)</small>}
      @if(_state.Character.HpCurrent<=0){<small class="bw-effects-list">@DeathText(_state.Character.DeathState,_state.Character.DeathSaveSuccesses,_state.Character.DeathSaveFailures)</small>}
     </div>
     <div class="bw-actor-btns">
      <button class="bw-inv-btn @(_invOpenFor=="hero"?"is-open":"")" title="@Lang.T("Инвентарь героя", "The hero's inventory")" @onclick='()=>ToggleInv("hero")'>🎒 @Lang.T("Инвентарь", "Inventory")</button>
      <button class="bw-inv-btn @(_skillOpenFor=="hero"?"is-open":"")" title="@Lang.T("Навыки героя", "The hero's skills")" @onclick='()=>ToggleSkills("hero")'>✦ @Lang.T("Навыки", "Skills")</button>
     </div>
     @if(_invOpenFor=="hero"){<BattleInventory ChatId="@_chatId" State="@_state" IsHero="true" Member="null" OnMessage="@OnInvMsg" />}
     @if(_skillOpenFor=="hero"){<BattleSkills State="@_state" IsHero="true" />}
     @FxLayer(HeroTarget)
    </div>
    @* ===== Спутники ===== *@
    @foreach(var p in _state.Party){
     var member=p;
     <div class="bw-actor bw-ally @ShakeClass(member.Name)">
      <span class="bw-ally-portrait" style="@PartyPortrait(member)"></span>
      <div class="bw-ally-main">
       <b class="bw-name"><span class="bw-name-t" title="@HeroTitle(member.Name)">@HeroTitle(member.Name)</span>@SeatBadge(member.Name,false)</b>
       <small>@member.Race · @member.CharClass</small>
       <div class="bw-bar">
        <span class="bw-bar-label">@Lang.T("Жизнь", "HP"): @member.HpCurrent/@member.HpMax@if(member.Shield>0){<text> · @Lang.T("щит", "shield") @member.Shield</text>}</span>
        <div class="bw-track"><i class="hp" style="@Css.Percent(member.HpCurrent,member.HpMax)"></i>@if(member.Shield>0){<em style="@Css.Percent(Math.Min(member.Shield,member.HpMax),member.HpMax)"></em>}</div>
       </div>
       @if(member.ManaMax>0){
        <div class="bw-bar">
         <span class="bw-bar-label">@Genre.PickT("Мана", "ОЗУ", "Концентрация", "Mana", "RAM", "Focus"): @member.ManaCurrent/@member.ManaMax</span>
         <div class="bw-track mana"><i style="@Css.Percent(member.ManaCurrent,member.ManaMax)"></i></div>
        </div>
       }
       @if(member.Status.Count>0){<small class="bw-effects-list">@string.Join(" · ",member.Status)</small>}
       @if(member.HpCurrent<=0){<small class="bw-effects-list">@DeathText(member.DeathState,member.DeathSaveSuccesses,member.DeathSaveFailures)</small>}
      </div>
      <div class="bw-actor-btns">
       <button class="bw-inv-btn @(_invOpenFor==member.Name?"is-open":"")" title="@(Lang.T("Инвентарь ", "Inventory of ") + member.Name)" @onclick='()=>ToggleInv(member.Name)'>🎒 @Lang.T("Инвентарь", "Inventory")</button>
       <button class="bw-inv-btn @(_skillOpenFor==member.Name?"is-open":"")" title="@(Lang.T("Навыки ", "Skills of ") + member.Name)" @onclick='()=>ToggleSkills(member.Name)'>✦ @Lang.T("Навыки", "Skills")</button>
      </div>
      @if(_invOpenFor==member.Name){<BattleInventory ChatId="@_chatId" State="@_state" IsHero="false" Member="@member" OnMessage="@OnInvMsg" />}
      @if(_skillOpenFor==member.Name){<BattleSkills IsHero="false" Member="@member" />}
      @FxLayer(member.Name)
     </div>
    }
   </div>
   <div class="bw-vs">VS</div>
   <div class="bw-side enemies"><h3>@Lang.T("Противники", "Adversaries")</h3>@foreach(var e in _state.Adversaries){<button class="bw-actor bw-enemy @(e.Name==_target?"selected":"") @(!e.InFight?"dead":"") @ShakeClass(e.Name) tier-@e.ThreatTier" @onclick="()=>_target=e.Name"><span class="bw-enemy-portrait" style="@EnemyPortrait(e)"></span><b class="bw-name"><span class="bw-name-t" title="@e.Name">@e.Name</span><em class="bw-tier">@ThreatTitle(e.ThreatTier)</em>@SeatBadge(e.Name,false)</b><small>@LevelText(e.Level) @e.Status@MoraleText(e)</small>@if(EnemyStats(e) is {Length:>0} stats){<small class="bw-enemy-stats">@stats</small>}<div class="bw-track"><i style="@Css.Percent(e.HpCurrent,e.HpMax)"></i>@if(e.Shield>0){<em style="@Css.Percent(Math.Min(e.Shield,e.HpMax),e.HpMax)"></em>}</div><span>@e.HpCurrent/@e.HpMax@if(e.Shield>0){<text> +@e.Shield @Lang.T("щит", "shield")</text>}</span>@if(e.Effects.Count>0){<small class="bw-effects-list">@string.Join(" · ",e.Effects)</small>}@FxLayer(e.Name)</button>}</div>

   @* ===== Оверлей броска кубика ===== *@
   @if (_dice is { } d)
   {
    <div class="bw-dice" @key="d.Key">
     <div class="bw-die @(d.Crit?"crit":d.Fail?"fail":"")"><span>@d.Value</span></div>
     @if(!string.IsNullOrWhiteSpace(d.Label)){<small>@d.Label</small>}
    </div>
   }
  </div>

  @* ===== История чата и ходов (на всю ширину окна) ===== *@
  <div class="bw-history">
    <div class="bw-history-head">@Lang.T("История чата и ходов", "Chat and turn history")</div>
    <div class="bw-history-body" @ref="_historyRef">
     @* Обёртка с margin-top:auto прижимает короткую историю к низу, но не ломает прокрутку вверх. *@
     <div class="bw-history-inner">
     @{
      var hist = History.ToList();
      // Пока идёт поток, последняя реплика мастера печатается отдельным блоком — в списке её не дублируем.
      if (_stream.Length > 0 && hist.Count > 0 && hist[^1].Role == "assistant") hist.RemoveAt(hist.Count - 1);
      // Держим последние 60 реплик, но в хронологическом порядке — новые снизу, старые уходят вверх.
      var shown = hist.Count > 60 ? hist.Skip(hist.Count - 60).ToList() : hist;
     }
     @if (shown.Count == 0 && _stream.Length == 0 && _status.Length == 0)
     {
      <div class="bw-history-empty">@Lang.T("В этом чате ещё нет реплик.", "There are no lines in this chat yet.")</div>
     }
     @foreach(var m in shown){
      <div class="bw-history-entry role-@m.Role">
       <span class="bw-history-role">@(m.Role=="user"?Lang.T("Вы", "You"):Lang.T("Мастер", "Master"))</span>
       <p>@Short(m.Content)</p>
      </div>
     }
     @if (_stream.Length > 0)
     {
      <div class="bw-history-entry role-assistant is-streaming">
       <span class="bw-history-role">@Lang.T("Мастер", "Master")</span>
       <p>@Short(_stream)<span class="bw-caret" aria-hidden="true"></span></p>
      </div>
     }
     else if (_status.Length > 0)
     {
      <div class="bw-think" role="status">
       <span class="bw-ink" aria-hidden="true"></span>
       <span class="bw-think-text">@_status</span>
      </div>
     }
     </div>
    </div>
   </div>

  @if (!Victory)
  {
   @if (HeroBlocked || AwaitingHeroTurn)
   {
    <div class="bw-down">@(HeroBlocked?Lang.T("☠ Герой не может действовать — ход пропускается, бой идёт сам.", "☠ The hero cannot act — the turn is skipped, the fight runs on its own."):Lang.T($"⏱ Сейчас ходит {_state.CombatCurrentActor} — очередь должна дойти до героя.", $"⏱ {_state.CombatCurrentActor} is acting now — the queue has to reach the hero.")) @Lang.T("Нажмите", "Press") «@(Busy?Lang.T("Ход идёт…", "Turn in progress…"):Lang.T("Продолжить бой", "Continue the fight"))».</div>
   }
   <div class="bw-controls"><label>@Lang.T("Цель", "Target")<select @bind="_target">@foreach(var e in _state.Adversaries.Where(x=>x.InFight)){<option>@e.Name</option>}</select></label><label>@Lang.T("Действие", "Action")<select @bind="_action"><option value="@BasicAttack">@BasicAttack</option>@foreach(var s in _state.Character.Skills){<option value="@s.Name">@s.Name (@s.Category)@(s.ManaCost>0?$" · {s.ManaCost} {Genre.ManaShort}":"")</option>}</select></label></div>
   <div class="bw-chat"><textarea @bind="_custom" placeholder="@Lang.T("Опциональная дополнительная информация по ходу или совсем нестандартное действие", "Optional extra details about the turn or a completely non-standard action")"></textarea><button class="bw-turn" @onclick="Turn" disabled="@(Busy||(!(HeroBlocked||AwaitingHeroTurn)&&_target.Length==0&&string.IsNullOrWhiteSpace(_custom)))">@(Busy?Lang.T("Ход идёт…", "Turn in progress…"):HeroBlocked||AwaitingHeroTurn?Lang.T("Продолжить бой", "Continue the fight"):Lang.T("Сделать ход", "Take turn"))</button></div>
  }
  else
  {
   <div class="bw-loot">
    <div class="bw-loot-head"><h3>@Lang.T("Добыча", "Loot")</h3><span class="bw-loot-picked">@Lang.T("Выбрано", "Selected") @_picked @Lang.T("из", "of") @_state.BattleLoot.Count</span></div>
    <div class="bw-loot-grid">
     @foreach(var item in _state.BattleLoot)
     {
      var picked=!_skipped.Contains(item.Id);
      <button class="bw-loot-item rar-@(ItemEconomy.RarityKey(item.Rarity)) @(picked?"taken":"")" @onclick="()=>Toggle(item)"
              title="@((picked ? Lang.T("Забрано в сумку", "Taken to the bag") : Lang.T("Не забирать", "Leave it")) + Lang.T(" — нажмите, чтобы переключить", " — click to toggle"))">
       <span class="bw-loot-check" aria-hidden="true">@(picked?"✓":"")</span>
       <span class="pix pix-@item.Icon"></span>
       <span class="bw-loot-main">
        <b>@item.Name@(item.Quantity>1?$" ×{item.Quantity}":"")</b>
        <small class="bw-loot-rarity">@LootMeta(item)</small>
        @if(LootDescription(item) is { Length: > 0 } desc)
        {
         <span class="bw-loot-desc">@desc</span>
        }
        @if(LootAdvisor.For(Economy,_state,item) is { Kind: not LootAdvisor.AdviceKind.None } adv)
        {
         <span class="bw-loot-advice @(adv.Kind==LootAdvisor.AdviceKind.Upgrade?"up":"sell")">@adv.Text</span>
        }
       </span>
       <span class="bw-loot-mark">@(picked?Lang.T("забрать", "take"):Lang.T("пропустить", "skip"))</span>
      </button>
     }
     @if(_state.BattleLoot.Count==0)
     {
      <span class="bw-loot-empty">@Lang.T("Ничего ценного.", "Nothing of value.")</span>
     }
    </div>
    <button class="bw-turn" @onclick="FinalizeLoot">@Lang.T("Забрать выбранное и завершить бой", "Take the selected and end the fight")</button>
   </div>
  }
 </section>
 <aside class="bw-blog">
  <div class="bw-blog-head">
   <span>@Lang.T("Лог боя", "Battle log")</span>
   <button class="bw-blog-clear" title="@Lang.T("Очистить лог боя", "Clear the battle log")" @onclick="ClearBattleLog">🧹</button>
  </div>
  <div class="bw-blog-body" @ref="_blogRef">
   @foreach (var e in BattleEntries)
   {
    <div class="bw-blog-row kind-@e.Kind @(_fresh.Contains(e.Id) ? "fresh" : "")" @key="e.Id">
     <span class="bw-blog-icon">@e.Icon</span>
     <span class="bw-blog-main">
      @if (e.Actor is { Length: > 0 } actor)
      {
       <b class="bw-blog-actor">@actor</b>
       <span class="bw-blog-arrow" aria-hidden="true">→</span>
      }
      @if (e.Subject is { Length: > 0 } subject)
      {
       <span class="bw-blog-subject">@subject</span>
      }
      else if (e.Text.Length > 0)
      {
       <span class="bw-blog-text">@e.Text</span>
      }
      @if (e.Value is { Length: > 0 } value)
      {
       <span class="bw-blog-value">@value</span>
      }
      @if (e.Verdict is { Length: > 0 } verdict)
      {
       <span class="bw-blog-tag @(e.VerdictBad ? "bad" : "good")">@verdict</span>
      }
      else if (e.Crit)
      {
       <span class="bw-blog-tag crit">@Lang.T("КРИТ", "CRIT")</span>
      }
      else if (e.Fail)
      {
       <span class="bw-blog-tag fail">@Lang.T("ПРОВАЛ", "FAIL")</span>
      }
      @* Урон стоит сразу за проверкой класса брони — видно, сколько сняли, не ища строку ниже. *@
      @if (e.Damage is int damage)
      {
       <span class="bw-blog-dmg">@Lang.T("урон", "damage") @damage</span>
      }
      @if (e.Detail is { Length: > 0 } detail)
      {
       <span class="bw-blog-detail">@detail</span>
      }
     </span>
    </div>
   }
   @if (BattleEntries.Count == 0) { <div class="bw-history-empty">@Lang.T("Журнал боя пуст — броски, урон и эффекты появятся здесь.", "The battle log is empty — rolls, damage and effects will appear here.")</div> }
  </div>
 </aside>
 </div></div>
}

@code{
 bool _open; string? _chatId; RpgState _state=new(); string _target="",_action=BasicAttack,_custom="";
 /// <summary>Подпись базовой атаки в списке действий (она же уходит мастеру в описании хода).</summary>
 static string BasicAttack=>Lang.T("Базовая атака", "Basic attack");
 // Отметки «пропустить» в окне добычи: пустое множество значит, что забираем всё — так весь лут
 // выбран по умолчанию, даже если предметы лягут в окно уже после открытия.
 HashSet<string> _skipped=new();
 string _status=""; string _stream=""; string? _invOpenFor; string? _skillOpenFor; string _invMsg=""; bool _invMsgOk;
 // Победа: все противники выбыли — либо бой кончился, а добыча ещё не забрана (окно должно остаться открытым).
 bool Victory=>(_state.Adversaries.Count>0&&_state.Adversaries.All(e=>!e.InFight))
  ||(_state.BattleLoot.Count>0&&!_state.Adversaries.Any(e=>e.InFight));
 /// <summary>Подпись выбывшего по морали: бежал или сдался.</summary>
 static string MoraleText(Adversary e)=>e.Morale switch{"fled"=>Lang.T(" · бежал", " · fled"),"surrendered"=>Lang.T(" · сдался", " · surrendered"),_=>""};

 // ===== Боевой журнал и анимации =====
 const string HeroTarget = BattleLogFeed.HeroTarget;
 ElementReference _blogRef;
 ElementReference _historyRef;
 long _logSeen;                         // последняя обработанная запись журнала (старые не проигрываем)
 bool _scrollLog;                       // прокрутить журнал после отрисовки
 bool _scrollHistory;                   // прокрутить историю чата после отрисовки (поток текста)
 bool _forceScrollLog;                  // прокрутить безусловно (открытие окна, свой ход игрока)
 bool _forceScrollHistory;
 bool _pinsBound;                       // слушатели «прилипания к низу» навешаны на текущие элементы
 bool _disposed;                        // компонент снят — отложенные анимации больше не трогаем
 readonly HashSet<long> _fresh=new();   // только что появившиеся записи (анимация входа)
 readonly List<Fx> _fx=new();           // всплывающие числа над карточками
 DiceFx? _dice;                         // оверлей броска
 long _fxSeq;
 Dictionary<string,int>? _initOrder;    // кэш очереди хода: имя → номер
 long _initStamp=-1;                    // номер последней записи журнала, для которой посчитан кэш

 IReadOnlyList<BattleLogEntry> BattleEntries => _chatId is null ? Array.Empty<BattleLogEntry>() : BattleLogSvc.Get(_chatId);

 // ===== Очередь хода =====
 static readonly Dictionary<string,int> EmptyOrder=new(StringComparer.OrdinalIgnoreCase);

 /// <summary>
 /// Очередь хода. Источник — состояние кампании (RpgState.Initiative): те же числа, что видит модель
 /// в сводке состояния, и они переживают перезапуск приложения. Если в состоянии очереди ещё нет
 /// (старый бой или бросок до этой правки) — берём порядок из записей боевого журнала, как раньше.
 /// Кэш журнала — по номеру последней записи, чтобы не пересчитывать на каждый рендер карточки.
 /// </summary>
 Dictionary<string,int> InitiativeOrder()
 {
  if(_chatId is null)return EmptyOrder;
  if(_state.Initiative.Count>0)return Initiative.Order(_state.Initiative);
  var stamp=BattleLogSvc.LastId(_chatId);
  if(_initOrder is not null&&_initStamp==stamp)return _initOrder;
  _initOrder=BattleLogFeed.InitiativeOrder(BattleLogSvc.Get(_chatId));
  _initStamp=stamp;
  return _initOrder;
 }

 /// <summary>Номер карточки в очереди хода; null — инициатива ещё не бросалась.</summary>
 int? TurnSeat(string name,bool isHero)
 {
  var order=InitiativeOrder();
  if(order.Count==0)return null;
  var key=(name??"").Trim();
  if(key.Length>0&&order.TryGetValue(key,out var seat))return seat;
  // Мастер мог записать героя как «Герой», а не по имени.
  return isHero&&(order.TryGetValue("Герой",out var heroSeat)||order.TryGetValue("Hero",out heroSeat))?heroSeat:null;
 }

 /// <summary>Бейдж «Очередь хода: X» рядом с именем — появляется только после бросков инициативы.</summary>
 RenderFragment SeatBadge(string name,bool isHero)=>b=>{
  if(TurnSeat(name,isHero) is not int seat)return;
  var current=_state.CombatRound>0&&CombatRules.SameActor(_state,name,_state.CombatCurrentActor);
  b.OpenElement(0,"em");
  b.AddAttribute(1,"class",current?"bw-init is-current":"bw-init");
  b.AddAttribute(2,"title",current?Lang.T("Сейчас действует этот участник", "This participant is acting now"):Lang.T("Очередь хода по инициативе", "Turn order by initiative"));
  b.AddContent(3,current?Lang.T($"Ход: {seat}", $"Turn: {seat}"):Lang.T($"Очередь хода: {seat}", $"Turn order: {seat}"));
  b.CloseElement();
 };

 protected override void OnInitialized(){Battle.OpenRequested+=Open;Battle.StatusChanged+=OnStatus;Battle.StreamChanged+=OnStream;RpgStore.StateChanged+=Changed;Store.Changed+=OnChatChanged;BattleLogSvc.Changed+=OnLogChanged;}
 public void Dispose(){_disposed=true;Battle.OpenRequested-=Open;Battle.StatusChanged-=OnStatus;Battle.StreamChanged-=OnStream;RpgStore.StateChanged-=Changed;Store.Changed-=OnChatChanged;BattleLogSvc.Changed-=OnLogChanged;}

 void Open(string id)=>_ = InvokeAsync(()=>{
  _chatId=id;_state=RpgStore.GetOrCreate(id);
  _target=_state.Adversaries.FirstOrDefault(e=>e.InFight)?.Name??"";
  // Окно могло открыться прямо посреди хода мастера — подхватываем текущий статус и поток текста.
  _status=Battle.StatusOf(id);_stream=Battle.StreamOf(id);
  _invOpenFor=null;_skillOpenFor=null;_invMsg="";_initOrder=null;_initStamp=-1;
  // Открываем окно без «проигрывания» уже накопленных событий боя.
  _logSeen=BattleLogSvc.LastId(id);_fresh.Clear();_fx.Clear();_dice=null;
  _open=true;_scrollLog=true;_scrollHistory=true;_forceScrollLog=true;_forceScrollHistory=true;_pinsBound=false;StateHasChanged();
 });
 void Changed(string id){if(_open&&id==_chatId)_ = InvokeAsync(StateHasChanged);}
 void OnStatus(string id,string status)=>_ = InvokeAsync(()=>{if(_open&&id==_chatId){_status=status;_scrollHistory=true;StateHasChanged();}});
 void OnStream(string id,string text)=>_ = InvokeAsync(()=>{if(_open&&id==_chatId){_stream=text;_scrollHistory=true;StateHasChanged();}});
 void OnChatChanged()=>_ = InvokeAsync(()=>{if(_open){_scrollHistory=true;StateHasChanged();}});

 void OnLogChanged(string id)=>_ = InvokeAsync(()=>{
  if(!_open||id!=_chatId)return;
  SyncAnimations();
  _scrollLog=true;
  StateHasChanged();
 });

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  // Элементы пересоздаются при каждом открытии окна — слушатели «прилипания» навешиваем заново.
  if(_open&&!_pinsBound&&_chatId is not null)
  {
   _pinsBound=true;
   try{await JS.InvokeVoidAsync("harness.trackPin",_historyRef);await JS.InvokeVoidAsync("harness.trackPin",_blogRef);}catch{}
  }
  if(_scrollLog){var force=_forceScrollLog;_forceScrollLog=false;_scrollLog=false;try{await JS.InvokeVoidAsync("harness.scrollBottom",_blogRef,force);}catch{}}
  if(_scrollHistory){var force=_forceScrollHistory;_forceScrollHistory=false;_scrollHistory=false;try{await JS.InvokeVoidAsync("harness.scrollBottom",_historyRef,force);}catch{}}
 }

 /// <summary>Разбирает новые записи журнала и запускает анимации: кубик и всплывающие числа.</summary>
 void SyncAnimations()
 {
  var chatId=_chatId;
  if(chatId is null)return;
  foreach(var e in BattleLogSvc.Get(chatId).Where(x=>x.Id>_logSeen))
  {
   _fresh.Add(e.Id);
   Expire(e.Id);
   if(e.Kind is "roll" or "attack" or "save"){if(e.Amount is int value)ShowDice(value,e.Label,e.Crit,e.Fail);}
   else if(e.Target is {Length:>0} t&&e.Amount is int amount)PushFx(t,e.Kind,amount);
  }
  _logSeen=BattleLogSvc.LastId(chatId);
 }

 /// <summary>Отложенное действие в UI-потоке: убирает всплывающее число и оверлей кубика.</summary>
 void Later(int ms,Action action)=>_=Task.Delay(ms).ContinueWith(t=>
 {
  try{_=InvokeAsync(()=>{if(!_disposed)action();});}
  catch{/* circuit уже закрыт */}
 },TaskScheduler.Default);

 void Expire(long id)=>Later(1700,()=>{if(_fresh.Remove(id))StateHasChanged();});

 void ShowDice(int value,string? label,bool crit,bool fail)
 {
  var key=++_fxSeq;
  _dice=new DiceFx(key,value,label,crit,fail);
  Later(1600,()=>{if(_dice?.Key==key){_dice=null;StateHasChanged();}});
 }

 void PushFx(string target,string kind,int amount)
 {
  var key=++_fxSeq;
  _fx.Add(new Fx(key,target,kind,AmountText(kind,amount)));
  Later(1200,()=>{_fx.RemoveAll(f=>f.Key==key);StateHasChanged();});
 }

 static string AmountText(string kind,int amount)=>kind switch{
  "damage"=>$"−{Math.Abs(amount)}",
  "shield"=>$"◈{amount}",
  _=>$"+{amount}",
 };

 IEnumerable<Fx> FxFor(string target)=>_fx.Where(f=>f.Target.Equals(target,StringComparison.OrdinalIgnoreCase));
 string ShakeClass(string target)=>_fx.Any(f=>f.Kind=="damage"&&f.Target.Equals(target,StringComparison.OrdinalIgnoreCase))?"is-hit":"";
 RenderFragment FxLayer(string target)=>b=>{foreach(var fx in FxFor(target)){b.OpenElement(0,"span");b.SetKey(fx.Key);b.AddAttribute(1,"class",$"bw-fx kind-{fx.Kind}");b.AddContent(2,fx.Text);b.CloseElement();}};

 void ClearBattleLog()
 {
  if(_chatId is null)return;
  BattleLogSvc.Clear(_chatId);
  _fresh.Clear();
  _logSeen=BattleLogSvc.LastId(_chatId);
 }

 sealed record Fx(long Key,string Target,string Kind,string Text);
 sealed record DiceFx(long Key,int Value,string? Label,bool Crit,bool Fail);

