 /// <summary>Боевые числа противника одной строкой: «КБ 15 · атака +6 ×2 · 2d8+3».</summary>
 static string EnemyStats(Adversary e)
 {
  var parts=new List<string>();
  if(e.Ac>0)parts.Add($"{Lang.T("КБ", "AC")} {e.Ac}");
  if(e.AttackBonus!=0||e.Damage.Length>0)parts.Add($"{Lang.T("атака", "attack")} {e.AttackBonus:+#;-#;+0}{(e.Attacks>1?$" ×{e.Attacks}":"")}{(e.Damage.Length>0?$" · {e.Damage}":"")}");
  if(e.StaggerMax>0)parts.Add($"{Lang.T("стойкость", "poise")} {e.Stagger}/{e.StaggerMax}");
  if(e.Legendary>0)parts.Add($"{Lang.T("легенд. действий", "legendary actions")} {e.Legendary}");
  return string.Join(" · ",parts);
 }
 /// <summary>«ур. 3»; уровни 0 и ниже — ослабленные существа для начинающего героя.</summary>
 static string LevelText(string? level)=>string.IsNullOrWhiteSpace(level)?"":int.TryParse(level.Trim(),out var l)&&l<1?Lang.T("слабый", "weak"):$"{Lang.T("ур.", "lvl")} {level.Trim()}";
 static string ThreatTitle(string? tier)=>Progression.RoleTitle(tier);
 static string DeathText(string? state,int successes,int failures)=>state switch{
  "stable"=>Lang.T($"Стабилизирован · спасброски {successes}/3 ✓ · {failures}/3 ✕", $"Stabilized · death saves {successes}/3 ✓ · {failures}/3 ✕"),
  "dead"=>Lang.T("Мёртв", "Dead"),
  _=>Lang.T($"При смерти · спасброски {successes}/3 ✓ · {failures}/3 ✕", $"Dying · death saves {successes}/3 ✓ · {failures}/3 ✕"),
 };

